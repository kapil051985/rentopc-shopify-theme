    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  <script>
    (function () {
      var sectionId = '{{ section.id }}';
      var priceId = 'price-' + sectionId;
      var currencyCode = {{ cart.currency.iso_code | json }};
      var currencyCodeEnabled = {{ settings.currency_code_enabled | json }};

      function formatMoney(cents) {
        if (typeof cents !== 'number') return '';

        var amount = cents / 100;

        try {
          return new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: currencyCode || 'INR',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0,
          }).format(amount);
        } catch (error) {
          var fallback = Math.round(amount).toLocaleString('en-IN');
          return 'Rs. ' + fallback;
        }
      }

      function updatePriceFromVariant(variant) {
        if (!variant) return;

        var priceRoot = document.getElementById(priceId);
        if (!priceRoot) return;

        var priceWrapper = priceRoot.querySelector('.price');
        if (!priceWrapper) return;

        var regularPriceNode = priceRoot.querySelector('.price__regular .price-item--regular');
        var salePriceNode = priceRoot.querySelector('.price__sale .price-item--sale');
        var comparePriceNode = priceRoot.querySelector('.price__sale .price-item--regular');
        var soldOutBadge = priceRoot.querySelector('.price__badge-sold-out');
        var saleBadge = priceRoot.querySelector('.price__badge-sale');
        var unitPriceNode = priceRoot.querySelector('.unit-price');

        var price = typeof variant.price === 'number' ? variant.price : 0;
        var compareAtPrice = typeof variant.compare_at_price === 'number' ? variant.compare_at_price : 0;
        var formattedPrice = formatMoney(price);
        var formattedCompareAtPrice = compareAtPrice > price ? formatMoney(compareAtPrice) : '';
        var isOnSale = compareAtPrice > price;
        var isAvailable = !!variant.available;

        if (regularPriceNode) {
          regularPriceNode.textContent = formattedPrice;
        }

        if (salePriceNode) {
          salePriceNode.textContent = formattedPrice;
        }

        if (comparePriceNode) {
          comparePriceNode.textContent = formattedCompareAtPrice;
        }

        priceWrapper.classList.toggle('price--on-sale', isOnSale);
        priceWrapper.classList.toggle('price--sold-out', !isAvailable);

        if (saleBadge) {
          saleBadge.style.display = isOnSale ? '' : 'none';
        }

        if (soldOutBadge) {
          soldOutBadge.style.display = isAvailable ? 'none' : '';
        }

        if (unitPriceNode) {
          unitPriceNode.classList.toggle('hidden', !variant.unit_price_measurement);
        }

        if (!currencyCodeEnabled) {
          return;
        }
      }

      function getVariantPickerRoot() {
        return document.querySelector('#MainProduct-' + sectionId + ' variant-selects, #MainProduct-' + sectionId + ' variant-radios');
      }

      function getSelectedOptionValues(variantRoot) {
        if (!variantRoot) return [];

        var selects = Array.prototype.slice.call(variantRoot.querySelectorAll('select'));
        var radios = Array.prototype.slice.call(variantRoot.querySelectorAll('fieldset input[type="radio"]:checked'));

        if (selects.length) {
          return selects.map(function (select) {
            return select.value;
          });
        }

        return radios.map(function (radio) {
          return radio.value;
        });
      }

      function updateSelectedVariantScript(variantRoot, variant) {
        if (!variantRoot || !variant) return;
        var selectedVariantNode = variantRoot.querySelector('[data-selected-variant]');
        if (!selectedVariantNode) return;
        selectedVariantNode.textContent = JSON.stringify(variant);
      }

      function updateVariantInputs(variant) {
        if (!variant || !variant.id) return;

        document.querySelectorAll(
          '#product-form-' + sectionId + ' input[name="id"], #product-form-installment-' + sectionId + ' input[name="id"]'
        ).forEach(function (input) {
          input.value = variant.id;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }

      function bindLocalVariantPriceSync() {
        var variantRoot = getVariantPickerRoot();
        if (!variantRoot || variantRoot.dataset.localPriceBound === 'true') return;
        variantRoot.dataset.localPriceBound = 'true';

        var variantsNode = variantRoot.querySelector('[data-product-variants]');
        if (!variantsNode) return;

        var variants = [];

        try {
          variants = JSON.parse(variantsNode.textContent || '[]');
        } catch (error) {
          variants = [];
        }

        if (!variants.length) return;

        function getMatchingVariant() {
          var selectedValues = getSelectedOptionValues(variantRoot);
          if (!selectedValues.length) return null;

          return variants.find(function (variant) {
            if (!variant.options || variant.options.length !== selectedValues.length) return false;

            return variant.options.every(function (optionValue, index) {
              return optionValue === selectedValues[index];
            });
          }) || null;
        }

        function syncLocalVariantState() {
          var matchedVariant = getMatchingVariant();
          if (!matchedVariant) return;

          updatePriceFromVariant(matchedVariant);
          updateVariantInputs(matchedVariant);
          updateSelectedVariantScript(variantRoot, matchedVariant);
        }

        variantRoot.addEventListener('change', syncLocalVariantState);
        syncLocalVariantState();
      }

      function syncPriceFromHtml(htmlDocument) {
        if (!htmlDocument) return;

        var source = htmlDocument.getElementById(priceId);
        var destination = document.getElementById(priceId);

        if (!source || !destination) return;

        destination.innerHTML = source.innerHTML;
        destination.classList.toggle('hidden', source.classList.contains('hidden'));
      }

      function bindPriceSync() {
        if (typeof subscribe !== 'function' || typeof PUB_SUB_EVENTS === 'undefined' || !PUB_SUB_EVENTS.variantChange) {
          bindLocalVariantPriceSync();
          return;
        }

        subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
          var detail = event && event.data ? event.data : null;
          if (!detail || detail.sectionId != sectionId) return;
          updatePriceFromVariant(detail.variant);
          syncPriceFromHtml(detail.html);
          setTimeout(bindLocalVariantPriceSync, 0);
          setTimeout(function () {
            if (typeof window.refreshVariantPickerEnhancements === 'function') {
              window.refreshVariantPickerEnhancements();
            }
          }, 0);
        });

        bindLocalVariantPriceSync();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindPriceSync);
      } else {
        bindPriceSync();
      }
    })();
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function isIE() {
        const ua = window.navigator.userAgent;
        const msie = ua.indexOf('MSIE ');
        const trident = ua.indexOf('Trident/');

        return msie > 0 || trident > 0;
      }

      if (!isIE()) return;
      const hiddenInput = document.querySelector('#{{ product_form_id }} input[name="id"]');
      const noScriptInputWrapper = document.createElement('div');
      const variantSwitcher =
        document.querySelector('variant-radios[data-section="{{ section.id }}"]') ||
        document.querySelector('variant-selects[data-section="{{ section.id }}"]');
      noScriptInputWrapper.innerHTML = document.querySelector(
        '.product-form__noscript-wrapper-{{ section.id }}'
      ).textContent;
      variantSwitcher.outerHTML = noScriptInputWrapper.outerHTML;

      document.querySelector('#Variants-{{ section.id }}').addEventListener('change', function (event) {
        hiddenInput.value = event.currentTarget.value;
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var shareActionBtn = document.querySelector('#MainProduct-{{ section.id }} [data-product-share]');
      if (shareActionBtn) {
        shareActionBtn.addEventListener('click', function () {
          var shareLink = shareActionBtn.getAttribute('data-product-share') || window.location.href;
          if (navigator.share) {
            navigator.share({
              title: {{ product.title | json }},
              url: shareLink
            }).catch(function () {});
            return;
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(shareLink).then(function () {
              shareActionBtn.classList.add('is-copied');
              setTimeout(function () {
                shareActionBtn.classList.remove('is-copied');
              }, 1200);
            }).catch(function () {});
          }
        });
      }

	      function alignZippyInline() {
	        var root = document.querySelector('#MainProduct-{{ section.id }} .product__info-container');
	        if (!root) return;

        var candidateLinks = Array.prototype.slice.call(root.querySelectorAll('a'));
        var zippyLink = candidateLinks.find(function (link) {
          var href = (link.getAttribute('href') || '').toLowerCase();
          var text = (link.textContent || '').toLowerCase();
          return href.indexOf('zippy') !== -1 || text.indexOf('zippy') !== -1;
        });
        if (!zippyLink) return;

        var poweredNode = zippyLink;
        var walker = zippyLink;
        while (walker && walker !== root) {
          var txt = (walker.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
          if (txt.indexOf('powered by') !== -1 && txt.length <= 100) {
            poweredNode = walker;
            break;
          }
          walker = walker.parentElement;
        }

	        var pinInput = root.querySelector(
	          "input[placeholder*='pin' i], input[placeholder*='pincode' i], input[placeholder*='zip' i], input[placeholder*='zipcode' i], input[name*='pin' i], input[name*='pincode' i], input[name*='zip' i], input[id*='pin' i], input[id*='pincode' i], input[id*='zip' i]"
	        );
	        if (!pinInput) return;

        var row =
          pinInput.closest('form') ||
          pinInput.closest("[class*='row' i], [class*='wrapper' i], [class*='container' i]") ||
          pinInput.parentElement;
        if (!row) return;

        var zippyRoot =
          zippyLink.closest("[class*='zippy' i], [id*='zippy' i]") ||
          row.closest("[class*='zippy' i], [id*='zippy' i]") ||
          row.parentElement;

	        row.classList.add('zippy-inline-row');
	        if (zippyRoot) {
	          zippyRoot.classList.add('zippy-inline-root');
	        }

	        // Hide the redundant pin/location icon so the row stays clean.
	        if (zippyRoot) {
	          var pinEmoji = '\uD83D\uDCCD';
	          var iconPool = Array.prototype.slice.call(
	            zippyRoot.querySelectorAll("svg, img, span, i, [class*='icon' i], [id*='icon' i]")
	          );

	          iconPool.forEach(function (el) {
	            if (!el || el === poweredNode) return;
	            var text = (el.textContent || '').trim();
	            var alt = (el.getAttribute && el.getAttribute('alt')) || '';
	            var title = (el.getAttribute && el.getAttribute('title')) || '';
	            var aria = (el.getAttribute && el.getAttribute('aria-label')) || '';
	            var cls =
	              (typeof el.className === 'object' && el.className && el.className.baseVal) ? el.className.baseVal : (el.className || '');
	            var id = el.id || '';
	            var hint = (text + ' ' + alt + ' ' + title + ' ' + aria + ' ' + cls + ' ' + id).toLowerCase();

	            if (
	              hint.indexOf(pinEmoji) !== -1 ||
	              hint.indexOf('location') !== -1 ||
	              hint.indexOf('map-marker') !== -1 ||
	              hint.indexOf('marker') !== -1 ||
	              hint.indexOf('pin') !== -1
	            ) {
	              el.style.display = 'none';
	              el.setAttribute('aria-hidden', 'true');
	            }
	          });
	        }

        poweredNode.classList.add('zippy-inline-powered');
        if (poweredNode.parentElement !== row) {
          row.appendChild(poweredNode);
        }

	        var checkButton = row.querySelector("button, input[type='submit'], [role='button']");
	        if (checkButton) {
	          checkButton.classList.add('zippy-inline-check');
	        }
	      }

	      function updateDeliveryEta(pinRaw) {
	        var etaNode = document.querySelector('#MainProduct-{{ section.id }} [data-delivery-eta]');
	        if (!etaNode) return;

		        // Read the configured window (set by the Liquid block on first render).
		        var minDays = parseInt(etaNode.getAttribute('data-min-days') || '2', 10);
		        var maxDays = parseInt(etaNode.getAttribute('data-max-days') || '5', 10);
		        if (!Number.isFinite(minDays)) minDays = 2;
		        if (!Number.isFinite(maxDays)) maxDays = 5;
		        if (maxDays < minDays) maxDays = minDays;
	
		        // Cutoff time: after 2pm, push the whole window by 1 day.
		        var now = new Date();
		        if (now.getHours() >= 14) {
		          minDays += 1;
		          maxDays += 1;
		        }
	
		        var minDate = new Date(now.getTime());
		        minDate.setDate(minDate.getDate() + minDays);
		        var maxDate = new Date(now.getTime());
		        maxDate.setDate(maxDate.getDate() + maxDays);
	
		        try {
		          var fmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short' });
		          var toParts = function (d) {
		            if (fmt.formatToParts) {
		              var parts = fmt.formatToParts(d);
		              var dayPart = parts.find(function (p) { return p.type === 'day'; });
		              var monthPart = parts.find(function (p) { return p.type === 'month'; });
		              return { day: (dayPart && dayPart.value) || '', month: (monthPart && monthPart.value) || '' };
		            }
		            var text = fmt.format(d);
		            var m = text.match(/(\\d{1,2})\\s+([A-Za-z]{3,})/);
		            return m ? { day: m[1], month: m[2] } : { day: text, month: '' };
		          };
	
		          var minP = toParts(minDate);
		          var maxP = toParts(maxDate);
	
		          var formattedRange =
		            minP.month && minP.month === maxP.month
		              ? (minP.day + '–' + maxP.day + ' ' + maxP.month)
		              : (minP.day + ' ' + minP.month + ' – ' + maxP.day + ' ' + maxP.month);
	
		          etaNode.textContent = formattedRange;
		        } catch (e) {
		          etaNode.textContent = minDate.toDateString() + ' - ' + maxDate.toDateString();
		        }
		      }

	      function wireDeliveryEtaToZippy() {
	        var root = document.querySelector('#MainProduct-{{ section.id }} .product__info-container');
	        if (!root) return;

	        var pinInput = root.querySelector(
	          "input[placeholder*='pin' i], input[placeholder*='pincode' i], input[placeholder*='zip' i], input[placeholder*='zipcode' i], input[name*='pin' i], input[name*='pincode' i], input[name*='zip' i], input[id*='pin' i], input[id*='pincode' i], input[id*='zip' i]"
	        );
	        var getPinFromDom = function () {
	          if (pinInput) {
	            var v = (pinInput.value || '').toString();
	            var digits = v.replace(/\D/g, '').slice(0, 6);
	            if (digits.length === 6) return digits;
	          }

	          // Fallback: parse from any "DELIVER TO 110092" text already rendered by the widget.
	          var text = (root.textContent || '').replace(/\s+/g, ' ');
	          var m = text.match(/(\d{6})/);
	          return m ? m[1] : '';
	        };

	        updateDeliveryEta(getPinFromDom());

	        if (pinInput) {
	          pinInput.addEventListener('input', function () {
	            updateDeliveryEta(getPinFromDom());
	          });
	        }

	        var checkBtn = root.querySelector('.zippy-inline-check');
	        if (checkBtn) {
	          checkBtn.addEventListener('click', function () {
	            setTimeout(function () {
	              updateDeliveryEta(getPinFromDom());
	            }, 50);
	          });
	        }
	      }

	      alignZippyInline();
	      wireDeliveryEtaToZippy();
	      setTimeout(alignZippyInline, 500);
	      setTimeout(wireDeliveryEtaToZippy, 520);
	      setTimeout(alignZippyInline, 1200);
	      setTimeout(wireDeliveryEtaToZippy, 1220);

      var zippyObserverRoot = document.querySelector('#MainProduct-{{ section.id }} .product__info-container');
      if (zippyObserverRoot && window.MutationObserver) {
        var zippyObserver = new MutationObserver(function () {
          alignZippyInline();
        });

        zippyObserver.observe(zippyObserverRoot, { childList: true, subtree: true });
        setTimeout(function () {
          zippyObserver.disconnect();
        }, 15000);
      }

        // Order selectors as Processor -> RAM -> Storage (then others).
        var refreshVariantPickerEnhancements = function () {
          var variantSelectRoot = document.querySelector('#MainProduct-{{ section.id }} variant-selects');
          if (!variantSelectRoot) return;

          var sortVariantInputs = function () {
            var optionNodes = Array.prototype.slice.call(variantSelectRoot.children).filter(function (el) {
              return el.matches('fieldset.product-form__input--swatch, fieldset.product-form__input--pill, .product-form__input--dropdown');
            });

          if (!optionNodes.length) return;

	          var getOrder = function (node) {
	            var labelNode = node.querySelector('legend, label');
	            var name = labelNode ? labelNode.textContent.toLowerCase() : '';
	            if (name.indexOf('processor') !== -1 || name.indexOf('cpu') !== -1 || name.indexOf('chip') !== -1) return 0;
	            if (name.indexOf('ram') !== -1 || name.indexOf('memory') !== -1) return 1;
	            if (name.indexOf('ssd') !== -1 || name.indexOf('hdd') !== -1 || name.indexOf('storage') !== -1) return 2;
	            return 3;
	          };

            var sortedNodes = optionNodes.slice().sort(function (a, b) {
              return getOrder(a) - getOrder(b);
            });

            sortedNodes.forEach(function (node) {
              variantSelectRoot.appendChild(node);
            });
          };

          function initCompactVariantModalDropdowns(rootNode) {
          if (!rootNode || !('HTMLDialogElement' in window)) return;

          var compactDropdowns = Array.prototype.slice.call(
            rootNode.querySelectorAll('.product-form__input--dropdown.is-compact')
          );

	          compactDropdowns.forEach(function (inputWrap, index) {
	            if (inputWrap.dataset.modalized === 'true') return;

            var select = inputWrap.querySelector('select.select__select');
            var labelNode = inputWrap.querySelector('label.form__label');
            if (!select || !labelNode) return;

            inputWrap.dataset.modalized = 'true';

            var selectContainer = inputWrap.querySelector('.select');
            if (!selectContainer) return;

            var trigger = document.createElement('button');
            trigger.type = 'button';
            trigger.className = 'variant-modal__trigger';
            trigger.setAttribute('aria-haspopup', 'dialog');
            trigger.setAttribute('aria-label', (labelNode.textContent || '').trim());

            var dialogId = 'VariantOptionDialog-{{ section.id }}-' + (select.id || String(index));
            var dialog = document.getElementById(dialogId);
            if (!dialog) {
              dialog = document.createElement('dialog');
              dialog.id = dialogId;
              dialog.className = 'variant-modal';
              dialog.innerHTML =
                '<div class="variant-modal__panel">' +
                  '<div class="variant-modal__header">' +
                    '<h3 class="variant-modal__title"></h3>' +
                    '<button type="button" class="variant-modal__close" aria-label="Close">&times;</button>' +
                  '</div>' +
                  '<div class="variant-modal__options" role="listbox"></div>' +
                '</div>';
              document.body.appendChild(dialog);
            }

            trigger.setAttribute('aria-controls', dialogId);
            selectContainer.appendChild(trigger);

            var titleNode = dialog.querySelector('.variant-modal__title');
            var closeBtn = dialog.querySelector('.variant-modal__close');
            var optionsRoot = dialog.querySelector('.variant-modal__options');

            if (titleNode) {
              titleNode.textContent = (labelNode.textContent || '').trim();
            }

            function syncTriggerLabel() {
              if (!select.selectedOptions || !select.selectedOptions.length) return;
              trigger.textContent = select.selectedOptions[0].textContent.trim();
            }

	            function renderDialogOptions() {
	              if (!optionsRoot) return;
	              optionsRoot.innerHTML = '';
	              var selectedButton = null;

	              Array.prototype.slice.call(select.options).forEach(function (opt) {
	                var optionBtn = document.createElement('button');
	                optionBtn.type = 'button';
	                optionBtn.className = 'variant-modal__option';
	                optionBtn.textContent = (opt.textContent || '').trim();
	                optionBtn.dataset.value = opt.value;
	                optionBtn.setAttribute('role', 'option');
	                optionBtn.setAttribute('aria-selected', opt.selected ? 'true' : 'false');

	                if (opt.selected) {
	                  optionBtn.classList.add('is-selected');
	                  selectedButton = optionBtn;
	                }

                if (opt.disabled) {
                  optionBtn.disabled = true;
                  optionBtn.classList.add('is-disabled');
                }

                optionBtn.addEventListener('click', function () {
                  if (opt.disabled) return;
                  select.value = opt.value;
                  select.dispatchEvent(new Event('change', { bubbles: true }));
                  syncTriggerLabel();
                  dialog.close();
                });

	                optionsRoot.appendChild(optionBtn);
	              });

	              if (selectedButton) {
	                selectedButton.scrollIntoView({ block: 'center' });
	              }
	            }

	            trigger.addEventListener('click', function () {
	              syncTriggerLabel();
	              renderDialogOptions();
	              dialog.showModal();
	            });

            if (closeBtn) {
              closeBtn.addEventListener('click', function () {
                dialog.close();
              });
            }

	            dialog.addEventListener('click', function (event) {
	              if (event.target === dialog) {
	                dialog.close();
	              }
	            });

	            dialog.addEventListener('close', function () {
	              try {
	                trigger.focus();
	              } catch (e) {}
	            });

            select.addEventListener('change', function () {
              syncTriggerLabel();
            });

            syncTriggerLabel();
          });
          }

          sortVariantInputs();
          initCompactVariantModalDropdowns(variantSelectRoot);
        };

        window.refreshVariantPickerEnhancements = refreshVariantPickerEnhancements;
        refreshVariantPickerEnhancements();

      // Dynamic "recently purchased" social proof ticker
      var cities = ['Mumbai', 'Delhi', 'Bangalore', 'Hyderabad', 'Ahmedabad', 'Chennai', 'Pune', 'Jaipur', 'Surat', 'Lucknow'];
      var times = ['just now', '2 mins ago', '5 mins ago', '12 mins ago', '1 hour ago'];
      var locEl = document.querySelector('.recently-purchased span');
	      if (locEl) {
	        var city = cities[Math.floor(Math.random() * cities.length)];
	        var time = times[Math.floor(Math.random() * times.length)];
	        locEl.textContent = '\uD83D\uDD25 Recently purchased by someone in ' + city + ' (' + time + ')';
	      }

	      // Buy Now button -- adds to cart then redirects to checkout
	      var buyNowBtn = document.querySelector('.buy-now-button');
      if (buyNowBtn) {
        buyNowBtn.addEventListener('click', function () {
          var variantId = document.querySelector('#{{ product_form_id }} input[name="id"]');
          if (!variantId || !variantId.value) return;
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId.value, quantity: 1 })
          }).then(function () {
            window.location.href = '/checkout';
          }).catch(function () {
            window.location.href = '/checkout';
          });
        });
      }
    });
  </script>

