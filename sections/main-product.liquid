<script>
  (function () {
    var initialized = false;

    function initProductGallery() {
      if (initialized || typeof Flickity === 'undefined') return;

      var sectionRoot = document.getElementById('MainProduct-{{ section.id }}');
      if (!sectionRoot) return;

      var mainCarousel = sectionRoot.querySelector('.carousel.product__image-slider');
      if (!mainCarousel || mainCarousel.classList.contains('flickity-enabled')) return;

      initialized = true;

      var flkty = new Flickity(mainCarousel, {
        contain: true,
        imagesLoaded: true,
        lazyLoad: 1,
        wrapAround: {% if product.images.size > 1 %}true{% else %}false{% endif %},
        pageDots: false,
        prevNextButtons: {% if product.images.size > 1 %}true{% else %}false{% endif %},
        draggable: {% if product.images.size > 1 %}true{% else %}false{% endif %},
        adaptiveHeight: true
      });

      var thumbnailCarousel = sectionRoot.querySelector('.carousel.product__image-thumbnail');
      if (thumbnailCarousel && !thumbnailCarousel.classList.contains('flickity-enabled')) {
        new Flickity(thumbnailCarousel, {
          asNavFor: mainCarousel,
          contain: true,
          imagesLoaded: true,
          lazyLoad: 2,
          pageDots: false,
          prevNextButtons: false
        });
      } else if (flkty.selectedElement) {
        flkty.selectedElement.removeAttribute('aria-hidden');
      }
    }

    function waitForFlickity() {
      if (typeof Flickity !== 'undefined') {
        initProductGallery();
        return;
      }

      window.setTimeout(waitForFlickity, 60);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', waitForFlickity);
    } else {
      waitForFlickity();
    }

    function applyReviewWidgetFixes() {
      var widgetSelector = [
        '.AirReviews',
        '[class*="AirReviews"]',
        '[class*="air-reviews" i]',
        '[class*="air" i][class*="review" i]',
        '[id*="airreviews" i]'
      ].join(',');

      var reviewWidgets = document.querySelectorAll(widgetSelector);
      if (!reviewWidgets.length) return;

      reviewWidgets.forEach(function (widget) {
        var hideControls = widget.querySelectorAll(
          '[class*="review" i][class*="show-more" i], [class*="review" i][class*="see-more" i], [class*="review" i][class*="see-all" i], [class*="review" i][class*="read-more" i]'
        );

        hideControls.forEach(function (control) {
          control.style.display = 'none';
        });

        var reviewTextBlocks = widget.querySelectorAll(
          '.AirReviews-Review__Content, .AirReviews-Review__Text, .AirReviews-ReviewCard__Content, [class*="review" i][class*="content" i], [class*="review" i][class*="text" i], [class*="truncate" i], [class*="clamp" i]'
        );

        reviewTextBlocks.forEach(function (block) {
          block.style.maxHeight = 'none';
          block.style.overflow = 'visible';
          block.style.display = 'block';
          block.style.webkitLineClamp = 'unset';
          block.style.lineClamp = 'unset';
        });

        var linksAndButtons = widget.querySelectorAll('a, button');
        linksAndButtons.forEach(function (node) {
          var label = (node.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
          if (label === 'see all' || label === 'see more' || label === 'read more' || label === 'show more') {
            node.style.display = 'none';
            node.setAttribute('aria-hidden', 'true');
          }
        });
      });
    }

    function queueReviewWidgetFixes() {
      if (window.__airReviewsFixQueued) return;
      window.__airReviewsFixQueued = true;

      window.requestAnimationFrame(function () {
        window.__airReviewsFixQueued = false;
        applyReviewWidgetFixes();
      });
    }

    queueReviewWidgetFixes();

    if (typeof MutationObserver !== 'undefined' && !window.__airReviewsFixObserverBound) {
      window.__airReviewsFixObserverBound = true;
      var observer = new MutationObserver(function () {
        queueReviewWidgetFixes();
      });

      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>

                          
