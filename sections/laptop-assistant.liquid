{{ 'laptop-assistant.css' | asset_url | stylesheet_tag }}
<script src="{{ 'laptop-assistant.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign assistant_collection = section.settings.collection
  if assistant_collection == blank
    assign assistant_collection = collections['refurbished-laptop']
  endif
  if assistant_collection == blank
    assign assistant_collection = collections['all']
  endif
-%}

<!-- Floating Action Button Container -->
<div class="laptop-assistant-fab-container">
  <div id="LaptopAssistantFABTooltip" class="laptop-assistant-fab-tooltip">
    <span id="LaptopAssistantFABTooltipText" class="laptop-assistant-fab-tooltip__text">Try Us</span>
  </div>

  <button
    type="button"
    id="LaptopAssistantFAB"
    class="laptop-assistant-fab"
    aria-label="{{ section.settings.fab_text }}"
    aria-haspopup="dialog"
  >
    <span class="laptop-assistant-fab__icon">
      {%- if section.settings.custom_svg_icon != blank -%}
        {{ section.settings.custom_svg_icon }}
      {%- elsif section.settings.custom_icon_image != blank -%}
        {{ section.settings.custom_icon_image | image_url: width: 48, height: 48 | image_tag: loading: 'lazy', class: 'laptop-assistant-fab__image-icon' }}
      {%- else -%}
        <img src="{{ 'laptop-finder-icon.png' | asset_url }}" alt="Laptop Finder" loading="lazy" class="laptop-assistant-fab__image-icon" width="48" height="48">
      {%- endif -%}
    </span>
  </button>
</div>

<!-- Assistant Side Drawer -->
<div id="LaptopAssistantDrawer" class="drawer laptop-assistant-drawer" role="dialog" aria-modal="true" aria-labelledby="LaptopAssistantTitle" hidden>
  <div id="LaptopAssistantDrawer-Overlay" class="cart-drawer__overlay"></div>
  <div class="drawer__inner gradient color-{{ section.settings.color_scheme }}">
    
    <!-- Header -->
    <div class="drawer__header">
      <div>
        <h2 id="LaptopAssistantTitle" class="drawer__heading h3">{{ section.settings.title }}</h2>
        <p class="laptop-assistant-subtitle">{{ section.settings.subtitle }}</p>
      </div>
      <button class="drawer__close" type="button" id="LaptopAssistantClose" aria-label="Close">
        <span class="svg-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </span>
      </button>
    </div>

    <!-- Body -->
    <div class="drawer__body laptop-assistant-body">
      
      <!-- Progress Bar -->
      <div id="LaptopAssistantProgress" class="la-progress-container">
        <div id="LaptopAssistantProgressBar" class="la-progress-fill"></div>
      </div>

      <div id="LaptopAssistantContent">
        
        <!-- Step 1: Primary Use -->
        <div class="laptop-assistant-step" data-step="1">
          <h3 class="laptop-assistant-step-title">What is your primary use?</h3>
          <div class="product-form__input product-form__input--pill laptop-assistant-options">
            <input type="radio" id="use-study" name="primaryUse" value="Study and Online Class" class="laptop-assistant-radio">
            <label for="use-study">Study and Online Class</label>

            <input type="radio" id="use-office" name="primaryUse" value="Office Work" class="laptop-assistant-radio">
            <label for="use-office">Office Work</label>

            <input type="radio" id="use-programming-design" name="primaryUse" value="Programming & Graphic Design" class="laptop-assistant-radio">
            <label for="use-programming-design">Programming and Graphic Design</label>

            <input type="radio" id="use-editing" name="primaryUse" value="Video Editing" class="laptop-assistant-radio">
            <label for="use-editing">Video Editing</label>

            <input type="radio" id="use-gaming" name="primaryUse" value="Light Gaming" class="laptop-assistant-radio">
            <label for="use-gaming">Light Gaming</label>
          </div>
        </div>

        <!-- Step 2: Budget -->
        <div class="laptop-assistant-step" data-step="2" hidden>
          <h3 class="laptop-assistant-step-title">What is your budget?</h3>
          <div class="product-form__input product-form__input--pill laptop-assistant-options">
            <input type="radio" id="budget-1" name="budget" value="10k-15k" class="laptop-assistant-radio">
            <label for="budget-1">₹10,000 - ₹15,000</label>

            <input type="radio" id="budget-2" name="budget" value="15k-25k" class="laptop-assistant-radio">
            <label for="budget-2">₹15,000 - ₹25,000</label>

            <input type="radio" id="budget-3" name="budget" value="25k-30k" class="laptop-assistant-radio">
            <label for="budget-3">₹25,000 - ₹30,000</label>

            <input type="radio" id="budget-4" name="budget" value="30k+" class="laptop-assistant-radio">
            <label for="budget-4">₹30,000+</label>
          </div>
        </div>

        <!-- Step 3: Brand -->
        <div class="laptop-assistant-step" data-step="3" hidden>
          <h3 class="laptop-assistant-step-title">Preferred Brand</h3>
          <div class="product-form__input product-form__input--pill laptop-assistant-options">
            <input type="radio" id="brand-dell" name="brand" value="Dell" class="laptop-assistant-radio">
            <label for="brand-dell">Dell</label>

            <input type="radio" id="brand-hp" name="brand" value="HP" class="laptop-assistant-radio">
            <label for="brand-hp">HP</label>

            <input type="radio" id="brand-lenovo" name="brand" value="Lenovo" class="laptop-assistant-radio">
            <label for="brand-lenovo">Lenovo</label>

            <input type="radio" id="brand-thinkpad" name="brand" value="ThinkPad" class="laptop-assistant-radio">
            <label for="brand-thinkpad">ThinkPad</label>

            <input type="radio" id="brand-nopref" name="brand" value="No Preference" class="laptop-assistant-radio">
            <label for="brand-nopref">No Preference</label>
          </div>
        </div>

        <!-- Step 4: Touch Screen -->
        <div class="laptop-assistant-step" data-step="4" hidden>
          <h3 class="laptop-assistant-step-title">Do you need a Touch Screen?</h3>
          <div class="product-form__input product-form__input--pill laptop-assistant-options">
            <input type="radio" id="touch-yes" name="touchscreen" value="Yes" class="laptop-assistant-radio">
            <label for="touch-yes">Yes</label>

            <input type="radio" id="touch-no" name="touchscreen" value="No" class="laptop-assistant-radio">
            <label for="touch-no">No</label>

            <input type="radio" id="touch-none" name="touchscreen" value="Doesn't Matter" class="laptop-assistant-radio">
            <label for="touch-none">Doesn't Matter</label>
          </div>
        </div>

        <!-- Results Area -->
        <div id="LaptopAssistantResults" class="laptop-assistant-results" hidden>
          <div class="laptop-assistant-results__header">
            <h3 class="h4">Your Top Recommendations</h3>
            <p class="laptop-assistant-results-intro">Based on your preferences, we found the best refurbished laptops for you:</p>
          </div>
          <div id="LaptopAssistantRecommendationsList" class="laptop-assistant-recommendations-list">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Comparison Area -->
        <div id="LaptopAssistantComparison" class="laptop-assistant-comparison" hidden>
          <!-- Dynamically populated side-by-side specs table -->
        </div>

      </div>
    </div>

    <!-- Footer -->
    <div class="drawer__footer laptop-assistant-footer-actions">
      <div class="laptop-assistant-footer-inner" id="LaptopAssistantFooterQuiz">
        <button type="button" id="LaptopAssistantPrev" class="button button--secondary" disabled>Back</button>
        <button type="button" id="LaptopAssistantNext" class="button button--primary" disabled>Next</button>
      </div>
      <div class="laptop-assistant-footer-inner" id="LaptopAssistantFooterResults" hidden>
        <button type="button" id="LaptopAssistantRestart" class="button button--secondary">Restart</button>
        <button type="button" id="LaptopAssistantCompareCTA" class="button button--secondary" disabled>Compare</button>
        <button type="button" id="LaptopAssistantCompareAll" class="button button--primary">Compare All 3</button>
      </div>
      <div class="laptop-assistant-footer-inner" id="LaptopAssistantFooterComparison" hidden>
        <button type="button" id="LaptopAssistantBackToResults" class="button button--secondary">Back to List</button>
      </div>
    </div>

  </div>
</div>

<!-- Fullscreen Comparison Page Modal -->
<div id="LaptopAssistantComparisonModal" class="laptop-assistant-comparison-modal" role="dialog" aria-modal="true" aria-labelledby="LaptopAssistantComparisonTitle" hidden>
  <div class="laptop-assistant-comparison-modal__header">
    <div>
      <h2 id="LaptopAssistantComparisonTitle" class="h3" style="margin: 0;">Compare Refurbished Laptops</h2>
      <p style="margin: 0.4rem 0 0; font-size: 1.3rem; color: #6b7280;">Side-by-side comparison of specifications, prices, and buy actions.</p>
    </div>
    <button type="button" id="LaptopAssistantCloseComparisonModal" class="drawer__close" aria-label="Close" style="top: 1.5rem; right: 2rem;">
      <span class="svg-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </span>
    </button>
  </div>
  <div class="laptop-assistant-comparison-modal__body">
    <div id="LaptopAssistantComparisonModalTable"></div>
  </div>
</div>

<!-- Raw Products Data Block -->
<script id="laptop-assistant-products-data" type="application/json">
  [
    {%- assign first_rendered = true -%}
    {%- for product in assistant_collection.products limit: 100 -%}
      {%- assign skip_product = false -%}
      {%- assign product_title_lc = product.title | downcase -%}
      {%- assign product_vendor_lc = product.vendor | downcase -%}
      {%- assign product_handle_lc = product.handle | downcase -%}
      {%- assign product_type_lc = product.type | downcase -%}
      
      {%- if product_title_lc contains 'rental' or product_vendor_lc contains 'rental' or product_handle_lc contains 'rental' -%}
        {%- assign skip_product = true -%}
      {%- endif -%}
      
      {%- if product_type_lc contains 'accessory' or product_type_lc contains 'accessories' or product_type_lc contains 'charger' or product_type_lc contains 'adapter' or product_type_lc contains 'cable' or product_type_lc contains 'warranty' or product_type_lc contains 'add-on' or product_type_lc contains 'addon' or product_type_lc contains 'gift card' or product_type_lc contains 'giftcard' or product_type_lc contains 'hub' or product_type_lc contains 'dock' or product_type_lc contains 'sleeve' or product_type_lc contains 'bag' or product_type_lc contains 'case' or product_type_lc contains 'mouse' or product_type_lc contains 'keyboard' -%}
        {%- assign skip_product = true -%}
      {%- endif -%}

      {%- if product_title_lc contains 'charger' or product_title_lc contains 'adapter' or product_title_lc contains 'cable' or product_title_lc contains 'warranty' or product_title_lc contains 'add-on' or product_title_lc contains 'addon' or product_title_lc contains 'gift card' or product_title_lc contains 'giftcard' or product_title_lc contains 'usb hub' or product_title_lc contains 'usb-c hub' or product_title_lc contains 'docking station' or product_title_lc contains 'sleeve' or product_title_lc contains 'backpack' or product_title_lc contains 'laptop bag' or product_title_lc contains 'mouse' or product_title_lc contains 'keyboard' or product_title_lc contains 'gift-card' -%}
        {%- assign skip_product = true -%}
      {%- endif -%}

      {%- for tag in product.tags -%}
        {%- assign tag_lc = tag | downcase -%}
        {%- if tag_lc contains 'rental' or tag_lc contains 'accessory' or tag_lc contains 'accessories' or tag_lc contains 'charger' or tag_lc contains 'adapter' or tag_lc contains 'cable' or tag_lc contains 'warranty' or tag_lc contains 'addon' or tag_lc contains 'add-on' or tag_lc contains 'gift card' or tag_lc contains 'giftcard' or tag_lc contains 'dock' or tag_lc contains 'hub' -%}
          {%- assign skip_product = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- unless skip_product -%}
        {%- if first_rendered == false -%},{%- endif -%}
        {%- assign first_rendered = false -%}
        {%- liquid
          assign la_processor = product.metafields.custom.specs_processor | metafield_text
          assign la_generation = product.metafields.custom.specs_generation | metafield_text
          assign la_display = product.metafields.custom.specs_screen_size | metafield_text
          assign la_graphics = product.metafields.custom.specs_graphics | metafield_text
          assign la_ram = product.metafields.custom.comparison_ram | metafield_text

          assign la_storage = product.metafields.comparison.storage.value
          if la_storage == blank
            assign la_storage = product.metafields.custom.comparison_storage.value
          endif
          if la_storage == blank
            assign la_storage = product.metafields.custom['comparison.storage'].value
          endif
          if la_storage == blank
            assign la_storage = product.metafields.comparison.storage | metafield_text
          endif
        -%}
        {
          "id": {{ product.id | json }},
          "title": {{ product.title | json }},
          "vendor": {{ product.vendor | json }},
          "type": {{ product.type | json }},
          "handle": {{ product.handle | json }},
          "url": {{ product.url | json }},
          "featured_image": {{ product.featured_media | image_url: width: 400 | json }},
          "price": {{ product.price | json }},
          "compare_at_price": {{ product.compare_at_price | json }},
          "available": {{ product.available | json }},
          "tags": {{ product.tags | json }},
          "options": {{ product.options | json }},
          "variants": [
            {%- for variant in product.variants -%}
              {%- unless forloop.first -%},{%- endunless -%}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "price": {{ variant.price | json }},
                "compare_at_price": {{ variant.compare_at_price | json }},
                "available": {{ variant.available | json }},
                "option1": {{ variant.option1 | json }},
                "option2": {{ variant.option2 | json }},
                "option3": {{ variant.option3 | json }}
              }
            {%- endfor -%}
          ],
          "metafields": {
            "processor": {{ la_processor | json }},
            "generation": {{ la_generation | json }},
            "display": {{ la_display | json }},
            "graphics": {{ la_graphics | json }},
            "ram": {{ la_ram | json }},
            "storage": {{ la_storage | json }},
            "os": {{ product.metafields.custom.specs_os | metafield_text | json }},
            "features": {{ product.metafields.custom.specs_features | metafield_text | json }},
            "condition": {{ product.metafields.custom.condition_grade | metafield_text | default: product.metafields.custom.cosmetic_condition | metafield_text | default: product.metafields.shopify['cosmetic_condition'] | metafield_text | json }},
            "battery": {{ product.metafields.custom.battery_health | metafield_text | json }},
            "warranty": {{ product.metafields.custom.warranty | metafield_text | default: product.metafields.shopify.warranty | metafield_text | default: "6 Months" | json }},
            "weight": {{ product.metafields.custom.weight | metafield_text | default: product.metafields.shopify.weight | metafield_text | default: "1.5 kg" | json }}
          }
        }
      {%- endunless -%}
    {%- endfor -%}
  ]
</script>

{% schema %}
{
  "name": "Laptop Finder Assistant",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection of Laptops",
      "info": "Choose the collection containing refurbished laptops (defaults to 'refurbished-laptop')."
    },
    {
      "type": "text",
      "id": "fab_text",
      "label": "FAB Button Text",
      "default": "Laptop Finder"
    },
    {
      "type": "html",
      "id": "custom_svg_icon",
      "label": "Custom SVG Icon Code",
      "info": "Paste custom SVG code here. It will override any custom icon image or default icon."
    },
    {
      "type": "image_picker",
      "id": "custom_icon_image",
      "label": "Custom Icon Image",
      "info": "Upload an image (PNG, SVG, etc.) to use as the icon. Used if Custom SVG code is blank."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Drawer Title",
      "default": "Laptop Finder"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Drawer Subtitle",
      "default": "Find your perfect refurbished laptop in 4 simple steps."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Laptop Finder Assistant"
    }
  ]
}
{% endschema %}
