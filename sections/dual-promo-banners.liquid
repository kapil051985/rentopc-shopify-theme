{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .dual-promo-banners {
    display: none;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  @media screen and (min-width: 750px) {
    .dual-promo-banners {
      display: block;
    }
  }

  .dual-promo-banners__grid {
    display: grid;
    gap: 0;
  }

  @media screen and (min-width: 750px) {
    .dual-promo-banners__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .dual-promo-banners__card {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 960 / 520;
    background: #111827;
    text-decoration: none;
  }

  .dual-promo-banners__image,
  .dual-promo-banners__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .dual-promo-banners__placeholder {
    background: linear-gradient(135deg, #e5e7eb, #cbd5e1);
  }
{%- endstyle -%}

<section class="dual-promo-banners section-{{ section.id }}-padding">
  <div class="dual-promo-banners__grid">
    {%- for block in section.blocks -%}
      {%- assign banner_link = block.settings.link -%}
      {%- if banner_link == blank -%}
        {%- assign banner_link = '#' -%}
      {%- endif -%}
      <a class="dual-promo-banners__card" href="{{ banner_link }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              class: 'dual-promo-banners__image',
              widths: '750, 1100, 1500, 2400',
              sizes: '(min-width: 750px) 50vw, 100vw'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'dual-promo-banners__placeholder placeholder-svg' }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Dual promo banners",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dual promo banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
