{{ 'ai-product-summary.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ai-product-summary.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign processor = product.metafields.custom.specs_processor | metafield_text
  assign generation = product.metafields.custom.specs_generation | metafield_text
  assign display = product.metafields.custom.specs_screen_size | metafield_text
  assign graphics = product.metafields.custom.specs_graphics | metafield_text
  assign ram = product.metafields.custom.comparison_ram | metafield_text

  assign storage = product.metafields.comparison.storage.value
  if storage == blank
    assign storage = product.metafields.custom.comparison_storage.value
  endif
  if storage == blank
    assign storage = product.metafields.custom['comparison.storage'].value
  endif
  if storage == blank
    assign storage = product.metafields.comparison.storage | metafield_text
  endif

  assign condition_grade = product.metafields.custom.condition_grade | metafield_text
  if condition_grade == blank
    assign condition_grade = product.metafields.custom.cosmetic_condition | metafield_text
  endif
  if condition_grade == blank
    assign condition_grade = product.metafields.shopify['cosmetic_condition'] | metafield_text
  endif

  assign battery_health = product.metafields.custom.battery_health | metafield_text
  
  assign product_type_lc = product.type | downcase
  assign product_title_lc = product.title | downcase
  assign is_accessory = false
  if product_type_lc contains 'accessory' or product_type_lc contains 'charger' or product_type_lc contains 'adapter' or product_type_lc contains 'bag' or product_type_lc contains 'mouse' or product_type_lc contains 'sleeve' or product_type_lc contains 'keyboard' or product_type_lc contains 'cable' or product_type_lc contains 'component'
    assign is_accessory = true
  endif
  if product_title_lc contains 'charger' or product_title_lc contains 'adapter' or product_title_lc contains 'bag' or product_title_lc contains 'sleeve' or product_title_lc contains 'mouse' or product_title_lc contains 'keyboard' or product_title_lc contains 'cable'
    unless product_title_lc contains 'laptop'
      assign is_accessory = true
    endunless
  endif
  for tag in product.tags
    assign tag_lc = tag | downcase
    if tag_lc contains 'accessory' or tag_lc contains 'accessories'
      assign is_accessory = true
    endif
  endfor
  for collection in product.collections
    if collection.handle == 'laptops-accessories' or collection.handle == 'laptop-accessories'
      assign is_accessory = true
    endif
  endfor

  if is_accessory
    assign default_warranty = '30 Days Seller Warranty'
  else
    assign default_warranty = '6 Months Seller Warranty'
  endif

  assign warranty = product.metafields.custom.warranty | metafield_text | default: product.metafields.shopify.warranty | metafield_text | default: default_warranty
  assign weight = product.metafields.custom.weight | metafield_text | default: product.metafields.shopify.weight | metafield_text | default: '1.5 kg'
-%}

{%- if product != blank -%}
  <div id="AISummaryRoot" data-ai-product-summary>
    
    <!-- Floating Action Button (FAB) -->
    <div class="ai-summary-fab-container">
      <div id="AISummaryFABTooltip" class="ai-summary-fab-tooltip">
        <span class="ai-summary-fab-tooltip__text">{{ section.settings.fab_tooltip_text | escape }}</span>
      </div>
      <button
        type="button"
        id="AISummaryFAB"
        class="ai-summary-fab"
        aria-label="{{ section.settings.fab_tooltip_text | escape }}"
        aria-haspopup="dialog"
      >
        <span class="ai-summary-fab__icon">
          <!-- Clipboard + Insight Sparkle SVG Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            <line x1="9" y1="12" x2="15" y2="12"></line>
            <line x1="9" y1="16" x2="13" y2="16"></line>
            <path d="M19 8l.3 1.2L20.5 9.5l-1.2.3L19 11l-.3-1.2-1.2-.3 1.2-.3.3-1.2z" fill="currentColor" stroke="none"></path>
          </svg>
        </span>
      </button>
    </div>

    <!-- Side Panel Drawer -->
    <div id="AISummaryDrawer" class="drawer ai-summary-drawer" role="dialog" aria-modal="true" aria-labelledby="AISummaryTitle" hidden>
      <div id="AISummaryDrawer-Overlay" class="cart-drawer__overlay"></div>
      <div class="drawer__inner gradient">
        
        <!-- Drawer Header -->
        <div class="drawer__header" style="align-items: center;">
          <div style="flex-grow: 1;">
            <h2 id="AISummaryTitle" class="drawer__heading h3" style="margin: 0; font-size: 2rem;">{{ section.settings.heading | escape }}</h2>
            <p class="ai-summary-subtitle" style="margin: 0.2rem 0 0; font-size: 1.2rem;">{{ section.settings.subtitle | escape }}</p>
          </div>
          <button type="button" id="AISummaryTranslateBtn" class="button button--secondary" style="margin-right: 1.5rem; font-size: 1.2rem; padding: 0.8rem 1.6rem; height: auto; min-height: auto;">Translate to Hindi</button>
          <button class="drawer__close" type="button" id="AISummaryClose" aria-label="Close" style="position: static; transform: none; padding: 0.8rem; margin: 0;">
            <span class="svg-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </span>
          </button>
        </div>

        <!-- Drawer Body -->
        <div class="drawer__body ai-summary-body" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; overflow-y: auto; max-height: calc(100vh - 70px);">
          
          <!-- Card: Quick Summary -->
          <div class="ai-summary-card" style="padding: 1.2rem; border-radius: 8px;">
            <div class="ai-summary-card__header" style="margin-bottom: 0.8rem; padding-bottom: 0.4rem;">
              <span class="ai-summary-card__icon-wrap" style="width: 2rem; height: 2rem; font-size: 1.1rem;">✦</span>
              <h3 class="ai-summary-card__title" style="font-size: 1.2rem;" data-summary-title-at-a-glance>At a Glance</h3>
            </div>
            <div class="ai-summary-card__body">
              <p class="ai-summary__quick-text" style="font-size: 1.3rem; line-height: 1.5;" data-summary-quick>
                Analyzing laptop specifications...
              </p>
            </div>
          </div>

          <!-- Card: Specifications Pills -->
          <div class="ai-summary-card" style="padding: 1.2rem; border-radius: 8px;">
            <div class="ai-summary-card__header" style="margin-bottom: 0.8rem; padding-bottom: 0.4rem;">
              <span class="ai-summary-card__icon-wrap" style="width: 2rem; height: 2rem; font-size: 1.1rem;">⚙</span>
              <h3 class="ai-summary-card__title" style="font-size: 1.2rem;" data-summary-title-specs>Specifications</h3>
            </div>
            <div class="ai-summary-card__body">
              <div class="ai-summary__specs-pills" data-summary-specs-pills style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                <!-- Dynamically populated spec pills -->
              </div>
            </div>
          </div>

          <!-- Card: Best Suited For -->
          <div class="ai-summary-card" style="padding: 1.2rem; border-radius: 8px;">
            <div class="ai-summary-card__header" style="margin-bottom: 0.8rem; padding-bottom: 0.4rem;">
              <span class="ai-summary-card__icon-wrap" style="width: 2rem; height: 2rem; font-size: 1.1rem;">✔</span>
              <h3 class="ai-summary-card__title" style="font-size: 1.2rem;" data-summary-title-best-for>Best Suited For</h3>
            </div>
            <div class="ai-summary-card__body">
              <div class="ai-summary__badges" data-summary-best-for style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                <span class="badge badge--secondary ai-summary-badge">Evaluating...</span>
              </div>
            </div>
          </div>

          <!-- Card: Can It Handle? -->
          <div class="ai-summary-card" style="padding: 1.2rem; border-radius: 8px; margin-bottom: 1rem;">
            <div class="ai-summary-card__header" style="margin-bottom: 0.8rem; padding-bottom: 0.4rem;">
              <span class="ai-summary-card__icon-wrap" style="width: 2rem; height: 2rem; font-size: 1.1rem;">⚒</span>
              <h3 class="ai-summary-card__title" style="font-size: 1.2rem;" data-summary-title-can-handle>Can It Handle?</h3>
            </div>
            <div class="ai-summary-card__body">
              <div class="ai-summary__checklist" data-summary-handle style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem;">
                <div>Checking software support...</div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- Product Metadata JSON Script -->
    <script id="ai-product-summary-data" type="application/json">
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "vendor": {{ product.vendor | json }},
        "type": {{ product.type | json }},
        "handle": {{ product.handle | json }},
        "tags": {{ product.tags | json }},
        "processor": {{ processor | json }},
        "generation": {{ generation | json }},
        "display": {{ display | json }},
        "graphics": {{ graphics | json }},
        "ram": {{ ram | json }},
        "storage": {{ storage | json }},
        "condition": {{ condition_grade | json }},
        "battery": {{ battery_health | json }},
        "warranty": {{ warranty | json }},
        "weight": {{ weight | json }},
        "selected_variant": {
          "id": {{ selected_variant.id | json }},
          "title": {{ selected_variant.title | json }},
          "price": {{ selected_variant.price | json }},
          "option1": {{ selected_variant.option1 | json }},
          "option2": {{ selected_variant.option2 | json }}
        }
      }
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "AI Product Summary",
  "tag": "section",
  "class": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "fab_tooltip_text",
      "label": "FAB Tooltip Text",
      "default": "AI Summary"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Drawer Heading",
      "default": "AI Product Summary"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Drawer Subtitle",
      "default": "Simplified specifications at a glance"
    }
  ],
  "presets": [
    {
      "name": "AI Product Summary"
    }
  ]
}
{% endschema %}
