        padding-right: {{ padding_horizontal }}rem !important;
      }
    }
  </style>
{% endif %}

<div class="section-{{ section.id }} featured-collection-{{ section.id }}" data-featured-collection style="background-color:{{ background_color }}; background-image: {{ background_gradient }};">
    <div class="section-{{ section.id }}-settings featured-collection-wrapper-{{ section.id }}">

        {% if invert_content %}

          {% if sub_heading != blank %}
            <p>{{ sub_heading }}</p>
          {% endif %}

        {% endif %}

        {% if heading != blank %}
          <div class="featured-collection-top-{{ section.id }}">
            <h2>{{ heading }}</h2>
	            <a class="featured-collection-link-{{ section.id }}" href="{{ link_url }}">
	              {{ link }}
	              <div class="featured-collection-arrow-{{ section.id }}">
	                &gt;
	              </div>
	            </a>
          </div>
        {% endif %}

        {% unless invert_content %}

          {% if sub_heading != blank %}
            <p>{{ sub_heading }}</p>
          {% endif %}

        {% endunless %}
        {% unless stack_products %}
          <div class="featured-collection-slider-{{ section.id }}" data-featured-collection-slider data-preview-mobile="{% if product_per_mobile == blank %} 1 {% else %}{{ product_per_mobile }}{% endif %}" data-preview-mobile-big="{% if product_per_mobile == blank %} 2 {% else %}{{ product_per_mobile | times: 2 | round: 0 }}{% endif %}" data-preview-desktop="{% if product_per_desktop == blank %} 4 {% else %}{{ product_per_desktop }}{% endif %}">
            {% if top_bar %}
              <div class="featured-collection-pagination-{{ section.id }} {% unless show_bar %} hide {% endunless %} swiper-pagination" data-featured-collection-pagination></div>
            {% endif %}
            <div class="swiper-wrapper">
              {% if ordered_items != blank %}
                {% for item in ordered_items limit:product_show %}
                  {% assign current_variant = item.selected_or_first_available_variant %}
                  {% assign compare_price = current_variant.compare_at_price %}
                  {% assign current_price = current_variant.price %}
                  {% assign discount_percentage = 0 %}
                  {% if compare_price > current_price and compare_price > 0 %}
                    {% assign discount_percentage = compare_price | minus: current_price | times: 100.0 | divided_by: compare_price | round %}
                  {% endif %}
                  {%- liquid
                    assign short_specs = item.metafields.custom.short_specs.value | default: item.metafields.custom.short_specs
                    if short_specs == blank
                      assign title_parts = item.title | replace: '(', ' ' | replace: ')', ' ' | replace: ',', ' ' | split: ' '
                      assign processor = ""
                      assign ram = ""
                      assign storage = ""
                      for part in title_parts
                        assign upcase_part = part | upcase
                        if upcase_part contains 'I3' or upcase_part contains 'I5' or upcase_part contains 'I7' or upcase_part contains 'I9' or upcase_part contains 'M1' or upcase_part contains 'M2' or upcase_part contains 'M3' or upcase_part contains 'RYZEN'
                          if processor == ""
                            assign processor = part
                          endif
                        elsif upcase_part contains 'GB' or upcase_part contains 'TB'
                          assign val = upcase_part | remove: 'GB' | remove: 'TB' | plus: 0
                          if val > 0
                            if val <= 64 and upcase_part contains 'GB'
                              if ram == ""
                                assign ram = part
                              endif
                            else
                              if storage == ""
                                assign storage = part
                              endif
                            endif
                          endif
                        endif
                      endfor
                      
                      assign extracted_specs = ""
                      if processor != ""
                        assign extracted_specs = extracted_specs | append: processor
                      endif
                      if ram != ""
                        if extracted_specs != ""
                          assign extracted_specs = extracted_specs | append: " • "
                        endif
                        assign extracted_specs = extracted_specs | append: ram
                      endif
                      if storage != ""
                        if extracted_specs != ""
                          assign extracted_specs = extracted_specs | append: " • "
                        endif
                        assign extracted_specs = extracted_specs | append: storage
                      endif
                      
                      if extracted_specs != ""
                        assign short_specs = extracted_specs
                      else
                        assign short_specs = 'Intel i5 • 8GB • 256GB SSD'
                      endif
                    endif
                  -%}
                  <article class="swiper-slide featured-collection-card-{{ section.id }}">
                    <a href="{{ item.url }}" class="featured-collection-image-link-{{ section.id }}" aria-label="View {{ item.title | escape }}">
                      <div class="featured-collection-image-{{ section.id }} {% if item.images.size > 1 %} has-secondary-{{ section.id }} {% endif %}">
                      {% if item.images.size > 0  %}
                        {% assign first_image_loading = 'lazy' %}
                        {% assign first_image_fetchpriority = 'auto' %}
                        {% if forloop.first %}
                          {% assign first_image_loading = 'eager' %}
                          {% assign first_image_fetchpriority = 'high' %}
                        {% endif %}
                        <img
                          class="{% if item.images.size > 1 %}featured-collection-first-image-{{ section.id }}{% endif %}"
                          srcset="
                            {{ item.featured_image | image_url: width: 208 }} 208w,
                            {{ item.featured_image | image_url: width: 314 }} 314w,
                            {{ item.featured_image | image_url: width: 417 }} 417w,
                            {{ item.featured_image | image_url: width: 626 }} 626w,
                            {{ item.featured_image | image_url: width: 834 }} 834w
                          "
                          sizes="{{ responsive_image_sizes }}"
                          src="{{ item.featured_image | image_url: width: 417 }}"
                          alt="{{ item.featured_image.alt | default: item.title | escape }}"
                          width="{{ item.featured_image.width }}"
                          height="{{ item.featured_image.height }}"
                          loading="{{ first_image_loading }}"
                          fetchpriority="{{ first_image_fetchpriority }}"
                        >
                      {% else %}
                        {{ 'collection-1' | placeholder_svg_tag }}
                      {% endif %}
                      {% if item.images.size > 1 %}
                        {% for img in item.images %}
                          {% if forloop.index == 2 %}
                            <img
                              class="featured-collection-second-image-{{ section.id }}"
                              srcset="
                                {{ img | image_url: width: 208 }} 208w,
                                {{ img | image_url: width: 314 }} 314w,
                                {{ img | image_url: width: 417 }} 417w,
                                {{ img | image_url: width: 626 }} 626w,
                                {{ img | image_url: width: 834 }} 834w
                              "
                              sizes="{{ responsive_image_sizes }}"
                              src="{{ img | image_url: width: 417 }}"
                              alt="{{ img.alt | default: item.title | escape }}"
                              width="{{ img.width }}"
                              height="{{ img.height }}"
                              loading="lazy"
                              fetchpriority="auto"
                            >
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    </div>
                    </a>
                    <div class="featured-collection-content-{{ section.id }}">
                      <a href="{{ item.url }}" class="featured-collection-title-{{ section.id }}">{{ item.title }}</a>
                      <div class="featured-collection-price-row-{{ section.id }}">
                        <p class="featured-collection-price-{{ section.id }}">{{ current_price | money }}</p>
                        {% if compare_price > current_price %}
                          <span class="featured-collection-compare-{{ section.id }}">{{ compare_price | money }}</span>
                          <span class="featured-collection-discount-{{ section.id }}">{{ discount_percentage }}% OFF</span>
                        {% endif %}
                      </div>
	                      <div class="featured-collection-actions-{{ section.id }}">
	                        {% render 'wishlisthero-collection-product', product: item, buttonClass: 'featured-collection-action-btn-' | append: section.id | append: ' is-wishlist' %}
	                        {%- liquid
	                          assign carousel_product_form_id = 'quick-add-' | append: section.id | append: item.id
	                          assign carousel_qty_rules = false
	                          if current_variant.quantity_rule.min > 1 or current_variant.quantity_rule.max != null or current_variant.quantity_rule.increment > 1
	                            assign carousel_qty_rules = true
	                          endif
	                        -%}
	                        {%- if item.variants_count > 1 or carousel_qty_rules -%}
	                          <modal-opener data-modal="#QuickAdd-{{ section.id }}-{{ item.id }}">
	                            <button
	                              id="{{ carousel_product_form_id }}-submit"
	                              type="button"
	                              class="featured-collection-action-btn-{{ section.id }} is-primary"
	                              aria-haspopup="dialog"
	                              aria-label="Choose options for {{ item.title | escape }}"
	                              data-product-url="{{ item.url }}"
	                              {% unless item.available %}disabled{% endunless %}
	                            >
	                              <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
	                                <path d="M3 5h2l1.1 9.2a2 2 0 0 0 2 1.8h7.8a2 2 0 0 0 2-1.7L19 8H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
	                                <circle cx="10" cy="19" r="1.5" fill="currentColor"/>
	                                <circle cx="17" cy="19" r="1.5" fill="currentColor"/>
	                              </svg>
	                              <span class="featured-collection-action-label-{{ section.id }}">
	                                {% if item.available %}Choose options{% else %}Sold out{% endif %}
	                              </span>
	                              {%- render 'loading-spinner' -%}
	                            </button>
	                          </modal-opener>
	                          <quick-add-modal id="QuickAdd-{{ section.id }}-{{ item.id }}" class="quick-add-modal">
	                            <div
	                              role="dialog"
	                              aria-label="{{ item.title | escape }}"
	                              aria-modal="true"
	                              class="quick-add-modal__content global-settings-popup"
	                              tabindex="-1"
	                            >
	                              <button
	                                id="ModalClose-{{ section.id }}-{{ item.id }}"
	                                type="button"
	                                class="quick-add-modal__toggle"
	                                aria-label="{{ 'accessibility.close' | t }}"
	                              >
	                                {{- 'icon-close.svg' | inline_asset_content -}}
	                              </button>
	                              <div id="QuickAddInfo-{{ section.id }}-{{ item.id }}" class="quick-add-modal__content-info"></div>
	                            </div>
	                          </quick-add-modal>
	                        {%- else -%}
	                          <form method="post" action="/cart/add" class="featured-collection-cart-form-{{ section.id }}">
	                            <input type="hidden" name="id" value="{{ current_variant.id }}">
	                            <button type="submit" class="featured-collection-action-btn-{{ section.id }} is-primary" aria-label="{% if current_variant.available %}Add {{ item.title | escape }} to cart{% else %}{{ item.title | escape }} sold out{% endif %}" title="{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}" {% unless current_variant.available %}disabled{% endunless %}>
	                              <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
	                                <path d="M3 5h2l1.1 9.2a2 2 0 0 0 2 1.8h7.8a2 2 0 0 0 2-1.7L19 8H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
	                                <circle cx="10" cy="19" r="1.5" fill="currentColor"/>
	                                <circle cx="17" cy="19" r="1.5" fill="currentColor"/>
	                              </svg>
	                              <span class="featured-collection-action-label-{{ section.id }}">
	                                {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
	                              </span>
	                            </button>
	                          </form>
	                        {%- endif -%}
	                        <a href="{{ item.url }}" class="featured-collection-action-btn-{{ section.id }} is-secondary" aria-label="View {{ item.title | escape }}" title="View">
	                          <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
	                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                          </svg>
                        </a>
                      </div>
                    </div>
                  </article>
                {% endfor %}
              {% else %}
                {% for item in (1..product_show) %}
                  <article class="swiper-slide featured-collection-card-{{ section.id }}">
                    <div class="featured-collection-image-{{ section.id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                    <div class="featured-collection-content-{{ section.id }}">
                      <p class="featured-collection-title-{{ section.id }}">Sample Product</p>
                      <div class="featured-collection-price-row-{{ section.id }}">
                        <p class="featured-collection-price-{{ section.id }}">₹29,999</p>
                        <span class="featured-collection-compare-{{ section.id }}">₹49,999</span>
                        <span class="featured-collection-discount-{{ section.id }}">40% OFF</span>
                      </div>
                      <div class="featured-collection-actions-{{ section.id }}">
                        <button type="button" class="featured-collection-action-btn-{{ section.id }} is-wishlist" aria-label="Add to wishlist" aria-pressed="false" title="Wishlist">
                          <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                            <path d="M12 20.6 4.8 13.8a4.8 4.8 0 0 1 6.8-6.8L12 7.4l.4-.4a4.8 4.8 0 0 1 6.8 6.8L12 20.6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                        <button type="button" class="featured-collection-action-btn-{{ section.id }} is-primary" aria-label="Add to cart" title="Add to cart">
                          <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                            <path d="M3 5h2l1.1 9.2a2 2 0 0 0 2 1.8h7.8a2 2 0 0 0 2-1.7L19 8H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="10" cy="19" r="1.5" fill="currentColor"/>
                            <circle cx="17" cy="19" r="1.5" fill="currentColor"/>
                          </svg>
                          <span class="featured-collection-action-label-{{ section.id }}">Add to cart</span>
                        </button>
                        <button type="button" class="featured-collection-action-btn-{{ section.id }} is-secondary" aria-label="View" title="View">
                          <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </article>
                {% endfor %}
              {% endif %}
            </div>
            <div class="featured-collection-btn-prev-{{ section.id }}" data-featured-collection-prev>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="featured-collection-btn-next-{{ section.id }}" data-featured-collection-next>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            {% unless top_bar %}
              <div class="featured-collection-pagination-{{ section.id }} {% unless show_bar %} hide {% endunless %} swiper-pagination" data-featured-collection-pagination></div>
            {% endunless %}
          </div>
        {% endunless %}

        {% if stack_products %}
          <div class="featured-collection-items-{{ section.id }}">
            {% if ordered_items != blank %}
              {% for item in ordered_items limit:product_show %}
                  {% assign current_variant = item.selected_or_first_available_variant %}
                  {% assign compare_price = current_variant.compare_at_price %}
                  {% assign current_price = current_variant.price %}
                  {% assign discount_percentage = 0 %}
                  {% if compare_price > current_price and compare_price > 0 %}
                    {% assign discount_percentage = compare_price | minus: current_price | times: 100.0 | divided_by: compare_price | round %}
                  {% endif %}
                  {%- liquid
                    assign short_specs = item.metafields.custom.short_specs.value | default: item.metafields.custom.short_specs
                    if short_specs == blank
                      assign title_parts = item.title | replace: '(', ' ' | replace: ')', ' ' | replace: ',', ' ' | split: ' '
                      assign processor = ""
                      assign ram = ""
                      assign storage = ""
                      for part in title_parts
                        assign upcase_part = part | upcase
                        if upcase_part contains 'I3' or upcase_part contains 'I5' or upcase_part contains 'I7' or upcase_part contains 'I9' or upcase_part contains 'M1' or upcase_part contains 'M2' or upcase_part contains 'M3' or upcase_part contains 'RYZEN'
                          if processor == ""
                            assign processor = part
                          endif
                        elsif upcase_part contains 'GB' or upcase_part contains 'TB'
                          assign val = upcase_part | remove: 'GB' | remove: 'TB' | plus: 0
                          if val > 0
                            if val <= 64 and upcase_part contains 'GB'
                              if ram == ""
                                assign ram = part
                              endif
                            else
                              if storage == ""
                                assign storage = part
                              endif
                            endif
                          endif
                        endif
                      endfor
                      
                      assign extracted_specs = ""
                      if processor != ""
                        assign extracted_specs = extracted_specs | append: processor
                      endif
                      if ram != ""
                        if extracted_specs != ""
                          assign extracted_specs = extracted_specs | append: " • "
                        endif
                        assign extracted_specs = extracted_specs | append: ram
                      endif
                      if storage != ""
                        if extracted_specs != ""
                          assign extracted_specs = extracted_specs | append: " • "
                        endif
                        assign extracted_specs = extracted_specs | append: storage
                      endif
                      
                      if extracted_specs != ""
                        assign short_specs = extracted_specs
                      else
                        assign short_specs = 'Intel i5 • 8GB • 256GB SSD'
                      endif
                    endif
                  -%}
                  <article class="featured-collection-item-{{ section.id }} featured-collection-card-{{ section.id }}">
                    <a href="{{ item.url }}" class="featured-collection-image-link-{{ section.id }}" aria-label="View {{ item.title | escape }}">
                    <div class="featured-collection-image-{{ section.id }} {% if item.images.size > 1 %} has-secondary-{{ section.id }} {% endif %}">
                      {% assign first_image_loading = 'lazy' %}
                      {% assign first_image_fetchpriority = 'auto' %}
                      {% if forloop.first %}
                        {% assign first_image_loading = 'eager' %}
                        {% assign first_image_fetchpriority = 'high' %}
                      {% endif %}
                      <img
                        class="{% if item.images.size > 1 %}featured-collection-first-image-{{ section.id }}{% endif %}"
                        srcset="
                          {{ item.featured_image | image_url: width: 208 }} 208w,
                          {{ item.featured_image | image_url: width: 314 }} 314w,
                          {{ item.featured_image | image_url: width: 417 }} 417w,
                          {{ item.featured_image | image_url: width: 626 }} 626w,
                          {{ item.featured_image | image_url: width: 834 }} 834w
                        "
                        sizes="{{ responsive_image_sizes }}"
                        src="{{ item.featured_image | image_url: width: 417 }}"
                        alt="{{ item.featured_image.alt | default: item.title | escape }}"
                        width="{{ item.featured_image.width }}"
                        height="{{ item.featured_image.height }}"
                        loading="{{ first_image_loading }}"
                        fetchpriority="{{ first_image_fetchpriority }}"
                      >
                      {% if item.images.size > 1 %}
                        {% for img in item.images %}
                          {% if forloop.index == 2 %}
                            <img
                              class="featured-collection-second-image-{{ section.id }}"
                              srcset="
                                {{ img | image_url: width: 208 }} 208w,
                                {{ img | image_url: width: 314 }} 314w,
                                {{ img | image_url: width: 417 }} 417w,
                                {{ img | image_url: width: 626 }} 626w,
                                {{ img | image_url: width: 834 }} 834w
                              "
                              sizes="{{ responsive_image_sizes }}"
                              src="{{ img | image_url: width: 417 }}"
                              alt="{{ img.alt | default: item.title | escape }}"
                              width="{{ img.width }}"
                              height="{{ img.height }}"
                              loading="lazy"
                              fetchpriority="auto"
                            >
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    </div>
                    </a>
                    <div class="featured-collection-content-{{ section.id }}">
                      <a href="{{ item.url }}" class="featured-collection-title-{{ section.id }}">{{ item.title }}</a>
                      <div class="featured-collection-price-row-{{ section.id }}">
                        <p class="featured-collection-price-{{ section.id }}">{{ current_price | money }}</p>
                        {% if compare_price > current_price %}
                          <span class="featured-collection-compare-{{ section.id }}">{{ compare_price | money }}</span>
                          <span class="featured-collection-discount-{{ section.id }}">{{ discount_percentage }}% OFF</span>
                        {% endif %}
                      </div>
	                      <div class="featured-collection-actions-{{ section.id }}">
	                        {% render 'wishlisthero-collection-product', product: item, buttonClass: 'featured-collection-action-btn-' | append: section.id | append: ' is-wishlist' %}
	                        {%- liquid
	                          assign carousel_product_form_id = 'quick-add-' | append: section.id | append: item.id
	                          assign carousel_qty_rules = false
	                          if current_variant.quantity_rule.min > 1 or current_variant.quantity_rule.max != null or current_variant.quantity_rule.increment > 1
	                            assign carousel_qty_rules = true
	                          endif
	                        -%}
	                        {%- if item.variants_count > 1 or carousel_qty_rules -%}
	                          <modal-opener data-modal="#QuickAdd-{{ section.id }}-{{ item.id }}">
	                            <button
	                              id="{{ carousel_product_form_id }}-submit"
	                              type="button"
	                              class="featured-collection-action-btn-{{ section.id }} is-primary"
	                              aria-haspopup="dialog"
	                              aria-label="Choose options for {{ item.title | escape }}"
	                              data-product-url="{{ item.url }}"
	                              {% unless item.available %}disabled{% endunless %}
	                            >
	                              <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
	                                <path d="M3 5h2l1.1 9.2a2 2 0 0 0 2 1.8h7.8a2 2 0 0 0 2-1.7L19 8H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
	                                <circle cx="10" cy="19" r="1.5" fill="currentColor"/>
	                                <circle cx="17" cy="19" r="1.5" fill="currentColor"/>
	                              </svg>
	                              <span class="featured-collection-action-label-{{ section.id }}">
	                                {% if item.available %}Choose options{% else %}Sold out{% endif %}
	                              </span>
	                              {%- render 'loading-spinner' -%}
	                            </button>
	                          </modal-opener>
	                          <quick-add-modal id="QuickAdd-{{ section.id }}-{{ item.id }}" class="quick-add-modal">
	                            <div
	                              role="dialog"
	                              aria-label="{{ item.title | escape }}"
	                              aria-modal="true"
	                              class="quick-add-modal__content global-settings-popup"
	                              tabindex="-1"
	                            >
	                              <button
	                                id="ModalClose-{{ section.id }}-{{ item.id }}"
	                                type="button"
	                                class="quick-add-modal__toggle"
	                                aria-label="{{ 'accessibility.close' | t }}"
	                              >
	                                {{- 'icon-close.svg' | inline_asset_content -}}
	                              </button>
	                              <div id="QuickAddInfo-{{ section.id }}-{{ item.id }}" class="quick-add-modal__content-info"></div>
	                            </div>
	                          </quick-add-modal>
	                        {%- else -%}
	                          <form method="post" action="/cart/add" class="featured-collection-cart-form-{{ section.id }}">
	                            <input type="hidden" name="id" value="{{ current_variant.id }}">
	                            <button type="submit" class="featured-collection-action-btn-{{ section.id }} is-primary" aria-label="{% if current_variant.available %}Add {{ item.title | escape }} to cart{% else %}{{ item.title | escape }} sold out{% endif %}" title="{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}" {% unless current_variant.available %}disabled{% endunless %}>
	                              <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
	                                <path d="M3 5h2l1.1 9.2a2 2 0 0 0 2 1.8h7.8a2 2 0 0 0 2-1.7L19 8H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
	                                <circle cx="10" cy="19" r="1.5" fill="currentColor"/>
	                                <circle cx="17" cy="19" r="1.5" fill="currentColor"/>
	                              </svg>
	                              <span class="featured-collection-action-label-{{ section.id }}">
	                                {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
	                              </span>
	                            </button>
	                          </form>
	                        {%- endif -%}
	                        <a href="{{ item.url }}" class="featured-collection-action-btn-{{ section.id }} is-secondary" aria-label="View {{ item.title | escape }}" title="View">
	                          <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
	                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                          </svg>
                        </a>
                      </div>
                    </div>
                  </article>
              {% endfor %}
            {% else %}
              {% for item in (1..product_show) %}
                <article class="featured-collection-item-{{ section.id }} featured-collection-card-{{ section.id }}">
                  <div class="featured-collection-image-{{ section.id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                  <div class="featured-collection-content-{{ section.id }}">
                    <p class="featured-collection-title-{{ section.id }}">Sample Product</p>
                    <div class="featured-collection-price-row-{{ section.id }}">
                      <p class="featured-collection-price-{{ section.id }}">₹29,999</p>
                      <span class="featured-collection-compare-{{ section.id }}">₹49,999</span>
                      <span class="featured-collection-discount-{{ section.id }}">40% OFF</span>
                    </div>
                    <div class="featured-collection-actions-{{ section.id }}">
                      <button type="button" class="featured-collection-action-btn-{{ section.id }} is-wishlist" aria-label="Add to wishlist" aria-pressed="false" title="Wishlist">
                        <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                          <path d="M12 20.6 4.8 13.8a4.8 4.8 0 0 1 6.8-6.8L12 7.4l.4-.4a4.8 4.8 0 0 1 6.8 6.8L12 20.6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                      <button type="button" class="featured-collection-action-btn-{{ section.id }} is-primary" aria-label="Add to cart" title="Add to cart">
                        <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                          <path d="M3 5h2l1.1 9.2a2 2 0 0 0 2 1.8h7.8a2 2 0 0 0 2-1.7L19 8H7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="10" cy="19" r="1.5" fill="currentColor"/>
                          <circle cx="17" cy="19" r="1.5" fill="currentColor"/>
                        </svg>
                        <span class="featured-collection-action-label-{{ section.id }}">Add to cart</span>
                      </button>
                      <button type="button" class="featured-collection-action-btn-{{ section.id }} is-secondary" aria-label="View" title="View">
                        <svg class="featured-collection-action-icon-{{ section.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                          <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                        </svg>
                      </button>
                    </div>
                  </div>
                </article>
              {% endfor %}
            {% endif %}
          </div>
        {% endif %}
    </div>
</div>

<script>
  (function () {
    if (window.__rentopcSwiperLoaded || window.__rentopcSwiperLoading) return;
    window.__rentopcSwiperLoading = true;

    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/swiper@6.8.4/swiper-bundle.min.js';
    script.defer = true;
    script.onload = function () {
      window.__rentopcSwiperLoaded = true;
    };
    document.head.appendChild(script);
  })();
</script>

<script src="{{ 'collection-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
  {
    "name": "Collection Carousel",
    "settings": [
       {
        "type": "paragraph",
        "content": "Support WebSensePro by [Subscribing our Channel](https:\/\/youtube.com\/@websensepro?sub_confirmation=1)"
      }, 
       {
        "type": "header",
        "content": "Save settings to display section correctly"
      },
      {
        "type": "header",
        "content": "Layout Settings"
      },
      {
        "type": "range",
        "id": "items_mt",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Cards Margin Top",
        "default": 40
      },
      {
        "type": "collection",
