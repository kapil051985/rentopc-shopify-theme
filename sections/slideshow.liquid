{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_split_point = section.blocks.size | plus: 1 | divided_by: 2
  assign desktop_left_count = desktop_split_point
  assign desktop_right_count = section.blocks.size | minus: desktop_left_count
  assign first_desktop_slide_image = blank
  assign first_mobile_slide_image = blank
  if section.blocks.size > 0
    assign first_desktop_slide_image = section.blocks.first.settings.image
    assign first_mobile_slide_image = section.blocks.first.settings.mobile_image | default: first_desktop_slide_image
    assign first_desktop_slide_image = first_desktop_slide_image | default: first_mobile_slide_image
  endif
-%}

{%- style -%}
  .slideshow-mobile-only {
    display: block;
  }

  .slideshow-desktop-split {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .slideshow-mobile-only {
      display: none;
    }

    .slideshow-desktop-split {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4px;
      width: 100%;
      margin-left: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .slideshow-desktop-split-wrap {
      position: relative;
    }

    .slideshow-desktop-split .slideshow-column {
      min-width: 0;
      overflow: hidden;
      position: relative;
      background: #0d0d0d;
      border-radius: 0;
    }

    .slideshow-desktop-split .slider-mobile-gutter {
      width: 100%;
    }

    .slideshow-desktop-split .slideshow {
      width: 100%;
    }

    .slideshow-desktop-split .slideshow-column:first-child .slideshow {
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
    }

    .slideshow-desktop-split .slideshow-column:last-child .slideshow {
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
    }

    .slideshow-desktop-split .slideshow__controls {
      display: none !important;
    }

    .slideshow-desktop-split-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      pointer-events: none;
      z-index: 1;
    }

    .slideshow-desktop-split-overlay .slider-button {
      pointer-events: auto;
      color: #ffffff;
      background: rgba(13, 13, 13, 0.72);
      border-radius: 999px;
      flex: 0 0 auto;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    }

    .slideshow-desktop-split-overlay .slider-button:hover {
      color: #ffffff;
      background: rgba(13, 13, 13, 0.88);
    }

    .slideshow-desktop-split-overlay .svg-wrapper svg,
    .slideshow-desktop-split-overlay .icon {
      width: 1rem;
      height: 1rem;
    }
  }

  @media screen and (max-width: 989px) {
    .slideshow-mobile-only {
      display: flex !important;
      flex-direction: column !important;
    }

    .slideshow-mobile-only > .slideshow {
      order: 1;
    }

    .slideshow-mobile-only > .slideshow__controls {
      order: 2 !important;
      width: 100%;
      margin-top: 1.5rem;
      padding: 0.75rem 1rem;
      box-sizing: border-box;
    }

    .slideshow-mobile-only > .slideshow__controls--top {
      order: 2 !important;
      margin-top: 1rem;
    }

    .slideshow-mobile-only .slideshow__autoplay {
      position: static;
      right: auto;
      margin-left: 0.75rem;
    }

    .slideshow-mobile-only .slider-buttons {
      justify-content: center;
      gap: 0.75rem;
    }
  }
{%- endstyle -%}

{%- if section.settings.slide_height == 'adapt_image' and first_desktop_slide_image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: first_mobile_slide_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}-desktop-left::before,
      #Slider-{{ section.id }}-desktop-left .media::before,
      #Slider-{{ section.id }}-desktop-right::before,
      #Slider-{{ section.id }}-desktop-right .media::before {
        padding-bottom: {{ 1 | divided_by: first_desktop_slide_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

<slideshow-component
  class="slider-mobile-gutter slideshow-mobile-only{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <style>
        #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
          opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
        }
      </style>
      {% render 'slideshow-slide',
        section: section,
        block: block,
        section_id: section.id,
        use_mobile_image: true,
        slide_index: forloop.index,
        slide_count: forloop.length,
        is_first_slide: forloop.first
      %}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</slideshow-component>

{%- if section.blocks.size > 0 -%}
  {%- assign desktop_left_section_id = section.id | append: '-desktop-left' -%}
  {%- assign desktop_right_section_id = section.id | append: '-desktop-right' -%}
  <div class="slideshow-desktop-split-wrap">
    <div class="slideshow-desktop-split">
      <div class="slideshow-column">
        <slideshow-component
          class="slider-mobile-gutter"
          role="region"
          aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
          aria-label="{{ section.settings.accessibility_info | escape }} - left"
        >
          <div
            class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
            id="Slider-{{ desktop_left_section_id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="false"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- assign desktop_left_render_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if forloop.index <= desktop_split_point -%}
                {%- assign desktop_left_render_index = desktop_left_render_index | plus: 1 -%}
                <style>
                  #Slide-{{ desktop_left_section_id }}-{{ desktop_left_render_index }} .banner__media::after {
                    opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
                  }
                </style>
                {% render 'slideshow-slide',
                  section: section,
                  block: block,
                  section_id: desktop_left_section_id,
                  slide_index: desktop_left_render_index,
                  slide_count: desktop_left_count,
                  is_first_slide: desktop_left_render_index == 1
                %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="slideshow-desktop-split-overlay" aria-hidden="true">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
              data-desktop-split-prev
              tabindex="-1"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
              data-desktop-split-next
              tabindex="-1"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        </slideshow-component>
      </div>

      <div class="slideshow-column">
        <slideshow-component
          class="slider-mobile-gutter"
          role="region"
          aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
          aria-label="{{ section.settings.accessibility_info | escape }} - right"
        >
          <div
            class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
            id="Slider-{{ desktop_right_section_id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="false"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- assign desktop_right_render_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if forloop.index > desktop_split_point -%}
                {%- assign desktop_right_render_index = desktop_right_render_index | plus: 1 -%}
                <style>
                  #Slide-{{ desktop_right_section_id }}-{{ desktop_right_render_index }} .banner__media::after {
                    opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
                  }
                </style>
                {% render 'slideshow-slide',
                  section: section,
                  block: block,
                  section_id: desktop_right_section_id,
                  slide_index: desktop_right_render_index,
                  slide_count: desktop_right_count,
                  is_first_slide: desktop_right_render_index == 1
                %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="slideshow-desktop-split-overlay" aria-hidden="true">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
              data-desktop-split-prev
              tabindex="-1"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
              data-desktop-split-next
              tabindex="-1"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        </slideshow-component>
      </div>
    </div>
  </div>
  <script>
    (() => {
      const root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      const shouldAutoplay = {{ section.settings.auto_rotate | json }};
      const leftSlider = root.querySelector('#Slider-{{ desktop_left_section_id }}');
      const rightSlider = root.querySelector('#Slider-{{ desktop_right_section_id }}');
      if (!leftSlider || !rightSlider) return;

      const prevButtons = Array.from(root.querySelectorAll('[data-desktop-split-prev]'));
      const nextButtons = Array.from(root.querySelectorAll('[data-desktop-split-next]'));
      if (!prevButtons.length || !nextButtons.length) return;

      const getSlideStep = (slider) => {
        const slides = Array.from(slider.querySelectorAll('.slideshow__slide')).filter((slide) => slide.offsetParent);
        if (slides.length > 1) {
          return slides[1].offsetLeft - slides[0].offsetLeft;
        }

        return slider.clientWidth;
      };

      const getTargetScrollLeft = (slider, direction) => {
        const step = getSlideStep(slider);
        const maxScrollLeft = slider.scrollWidth - slider.clientWidth;

        if (direction === 'next') {
          return slider.scrollLeft >= maxScrollLeft - 1 ? 0 : Math.min(slider.scrollLeft + step, maxScrollLeft);
        }

        return slider.scrollLeft <= 1 ? maxScrollLeft : Math.max(slider.scrollLeft - step, 0);
      };

      const moveSlider = (slider, direction) => {
        slider.scrollTo({
          left: getTargetScrollLeft(slider, direction),
          behavior: 'smooth',
        });
      };

      const moveBoth = (direction) => {
        [leftSlider, rightSlider].forEach((slider) => moveSlider(slider, direction));
      };

      prevButtons.forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          moveBoth('previous');
        });
      });

      nextButtons.forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          moveBoth('next');
        });
      });

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let autoplayTimer = null;

      const stopAutoplay = () => {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (!shouldAutoplay || !window.matchMedia('(min-width: 990px)').matches || reducedMotion.matches) return;
        autoplayTimer = setInterval(() => moveBoth('next'), 3000);
      };

      reducedMotion.addEventListener('change', startAutoplay);
      window.addEventListener('resize', startAutoplay);
      startAutoplay();
    })();
  </script>
{%- endif -%}

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "t:sections.slideshow.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.slideshow.settings.layout.options__2.label"
        }
      ],
      "default": "full_bleed",
      "label": "t:sections.slideshow.settings.layout.label"
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "adapt_image",
          "label": "t:sections.slideshow.settings.slide_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.slide_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.slide_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.slide_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.slideshow.settings.slide_height.label"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        {
          "value": "dots",
          "label": "t:sections.slideshow.settings.slider_visual.options__2.label"
        },
        {
          "value": "counter",
          "label": "t:sections.slideshow.settings.slider_visual.options__1.label"
        },
        {
          "value": "numbers",
          "label": "t:sections.slideshow.settings.slider_visual.options__3.label"
        }
      ],
      "default": "counter",
      "label": "t:sections.slideshow.settings.slider_visual.label"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.slideshow.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "t:sections.slideshow.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.mobile.content"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "label": "t:sections.slideshow.settings.show_text_below.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.accessibility.content"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "t:sections.slideshow.settings.accessibility.label",
      "info": "t:sections.slideshow.settings.accessibility.info",
      "default": "t:sections.slideshow.settings.accessibility.default"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
	"type": "url",
	"id": "image_link",
"label": "Image Link"
},
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "t:sections.slideshow.blocks.slide.settings.image_overlay_opacity.label",
          "default": 0
        },
        {
          "type": "header",
          "content": "t:sections.slideshow.blocks.slide.settings.header_text.content"
        },
        {
