<link rel="stylesheet" href="{{ 'section-product-comparison.css' | asset_url }}" media="print" onload="this.media='all'">

{%- liquid
  assign comparison_collection = section.settings.collection

  if comparison_collection == blank and collection != blank and collection.products_count > 1
    assign comparison_collection = collection
  endif

  if comparison_collection == blank and product.collections != blank
    for product_collection in product.collections
      if product_collection.products_count > 1
        assign comparison_collection = product_collection
        break
      endif
    endfor
  endif

  assign comparison_products = comparison_collection.products
  assign max_similar_products = section.settings.products_to_compare
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
	  <section class="product-comparison page-width section-{{ section.id }}-padding cv-auto">
    <div class="product-comparison__header">
      <h2 class="inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="product-comparison__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if comparison_products != blank -%}
      {%- assign found_similar = 0 -%}
      {%- for candidate in comparison_products -%}
        {%- if candidate.id != product.id and found_similar < max_similar_products -%}
          {%- assign found_similar = found_similar | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if found_similar > 0 -%}
        <div class="product-comparison__table-wrap">
          <table class="product-comparison__table" role="table">
            <thead>
              <tr>
                <th scope="col" class="product-comparison__label-col">Compare with similar items</th>
                <th scope="col" class="product-comparison__product-col product-comparison__product-col--current">
                  <a href="{{ product.url }}" target="_blank" class="product-comparison__product-card" aria-label="{{ product.title | escape }}">
                    {%- if product.featured_media != blank -%}
                      <img
                        src="{{ product.featured_media | image_url: width: 220 }}"
                        alt="{{ product.featured_media.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="110"
                        height="110"
                      >
                    {%- endif -%}
                    <span class="product-comparison__tag">Current product</span>
                    <span class="product-comparison__product-title">{{ product.title }}</span>
                  </a>
                </th>

                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    <th scope="col" class="product-comparison__product-col">
                      <a href="{{ candidate.url }}" target="_blank" class="product-comparison__product-card" aria-label="{{ candidate.title | escape }}">
                        {%- if candidate.featured_media != blank -%}
                          <img
                            src="{{ candidate.featured_media | image_url: width: 220 }}"
                            alt="{{ candidate.featured_media.alt | default: candidate.title | escape }}"
                            loading="lazy"
                            width="110"
                            height="110"
                          >
                        {%- endif -%}
                        <span class="product-comparison__product-title">{{ candidate.title }}</span>
                      </a>
                    </th>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row" class="product-comparison__label-col">Price</th>
                <td class="product-comparison__product-col product-comparison__product-col--current">
                  <div class="product-comparison__price-block">
                    <span class="product-comparison__price">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="product-comparison__mrp">M.R.P: <s>{{ product.compare_at_price | money }}</s></span>
                      <span class="product-comparison__discount">
                        {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% off
                      </span>
                    {%- endif -%}
                  </div>
                </td>
                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    <td class="product-comparison__product-col">
                      <div class="product-comparison__price-block">
                        <span class="product-comparison__price">{{ candidate.price | money }}</span>
                        {%- if candidate.compare_at_price > candidate.price -%}
                          <span class="product-comparison__mrp">M.R.P: <s>{{ candidate.compare_at_price | money }}</s></span>
                          <span class="product-comparison__discount">
                            {{ candidate.compare_at_price | minus: candidate.price | times: 100.0 | divided_by: candidate.compare_at_price | round }}% off
                          </span>
                        {%- endif -%}
                      </div>
                    </td>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
              {%- comment -%}
                Removed "Use case" row from comparison table per request.
              {%- endcomment -%}
              <tr>
                <th scope="row" class="product-comparison__label-col">Display size</th>
                {%- assign current_display = product.metafields.comparison['display.size'].value -%}
                {%- if current_display == blank -%}{%- assign current_display = product.metafields['comparison.display'].size.value -%}{%- endif -%}
                {%- if current_display == blank -%}{%- assign current_display = product.metafields.custom.comparison_display_size.value -%}{%- endif -%}
                {%- if current_display == blank -%}{%- assign current_display = product.metafields.custom['comparison.display.size'].value -%}{%- endif -%}
                {%- if current_display == blank -%}{%- assign current_display = product.metafields.comparison['display.size'] | metafield_text -%}{%- endif -%}
                <td class="product-comparison__product-col product-comparison__product-col--current">
                  {%- if current_display != blank -%}
                    {%- assign current_display_short = current_display | strip_html | truncatewords: 10, '...' -%}
                    <span class="product-comparison__spec-compact" title="{{ current_display | strip_html | escape }}">{{ current_display_short }}</span>
                  {%- else -%}
                    N/A
                  {%- endif -%}
                </td>
                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    {%- assign candidate_display = candidate.metafields.comparison['display.size'].value -%}
                    {%- if candidate_display == blank -%}{%- assign candidate_display = candidate.metafields['comparison.display'].size.value -%}{%- endif -%}
                    {%- if candidate_display == blank -%}{%- assign candidate_display = candidate.metafields.custom.comparison_display_size.value -%}{%- endif -%}
                    {%- if candidate_display == blank -%}{%- assign candidate_display = candidate.metafields.custom['comparison.display.size'].value -%}{%- endif -%}
                    {%- if candidate_display == blank -%}{%- assign candidate_display = candidate.metafields.comparison['display.size'] | metafield_text -%}{%- endif -%}
                    <td class="product-comparison__product-col">
                      {%- if candidate_display != blank -%}
                        {%- assign candidate_display_short = candidate_display | strip_html | truncatewords: 10, '...' -%}
                        <span class="product-comparison__spec-compact" title="{{ candidate_display | strip_html | escape }}">{{ candidate_display_short }}</span>
                      {%- else -%}
                        N/A
                      {%- endif -%}
                    </td>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
              <tr>
                <th scope="row" class="product-comparison__label-col">RAM</th>
                {%- assign current_ram = product.metafields.comparison.ram.value -%}
                {%- if current_ram == blank -%}{%- assign current_ram = product.metafields.custom.comparison_ram.value -%}{%- endif -%}
                {%- if current_ram == blank -%}{%- assign current_ram = product.metafields.custom['comparison.ram'].value -%}{%- endif -%}
                {%- if current_ram == blank -%}{%- assign current_ram = product.metafields.comparison.ram | metafield_text -%}{%- endif -%}
                <td class="product-comparison__product-col product-comparison__product-col--current">
                  {%- if current_ram != blank -%}
                    <span class="product-comparison__spec-compact product-comparison__value-strong" title="{{ current_ram | strip_html | escape }}">{{ current_ram | strip_html | truncatewords: 8, '...' }}</span>
                  {%- else -%}
                    N/A
                  {%- endif -%}
                </td>
                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    {%- assign candidate_ram = candidate.metafields.comparison.ram.value -%}
                    {%- if candidate_ram == blank -%}{%- assign candidate_ram = candidate.metafields.custom.comparison_ram.value -%}{%- endif -%}
                    {%- if candidate_ram == blank -%}{%- assign candidate_ram = candidate.metafields.custom['comparison.ram'].value -%}{%- endif -%}
                    {%- if candidate_ram == blank -%}{%- assign candidate_ram = candidate.metafields.comparison.ram | metafield_text -%}{%- endif -%}
                    <td class="product-comparison__product-col">
                    {%- if candidate_ram != blank -%}
                        <span class="product-comparison__spec-compact product-comparison__value-strong" title="{{ candidate_ram | strip_html | escape }}">{{ candidate_ram | strip_html | truncatewords: 8, '...' }}</span>
                      {%- else -%}
                        N/A
                      {%- endif -%}
                    </td>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
              <tr>
                <th scope="row" class="product-comparison__label-col">Storage</th>
                {%- assign current_storage = product.metafields.comparison.storage.value -%}
                {%- if current_storage == blank -%}{%- assign current_storage = product.metafields.custom.comparison_storage.value -%}{%- endif -%}
                {%- if current_storage == blank -%}{%- assign current_storage = product.metafields.custom['comparison.storage'].value -%}{%- endif -%}
                {%- if current_storage == blank -%}{%- assign current_storage = product.metafields.comparison.storage | metafield_text -%}{%- endif -%}
                <td class="product-comparison__product-col product-comparison__product-col--current">
                  {%- if current_storage != blank -%}
                    <span class="product-comparison__spec-compact product-comparison__value-strong" title="{{ current_storage | strip_html | escape }}">{{ current_storage | strip_html | truncatewords: 8, '...' }}</span>
                  {%- else -%}
                    N/A
                  {%- endif -%}
                </td>
                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    {%- assign candidate_storage = candidate.metafields.comparison.storage.value -%}
                    {%- if candidate_storage == blank -%}{%- assign candidate_storage = candidate.metafields.custom.comparison_storage.value -%}{%- endif -%}
                    {%- if candidate_storage == blank -%}{%- assign candidate_storage = candidate.metafields.custom['comparison.storage'].value -%}{%- endif -%}
                    {%- if candidate_storage == blank -%}{%- assign candidate_storage = candidate.metafields.comparison.storage | metafield_text -%}{%- endif -%}
                    <td class="product-comparison__product-col">
                      {%- if candidate_storage != blank -%}
                        <span class="product-comparison__spec-compact product-comparison__value-strong" title="{{ candidate_storage | strip_html | escape }}">{{ candidate_storage | strip_html | truncatewords: 8, '...' }}</span>
                      {%- else -%}
                        N/A
                      {%- endif -%}
                    </td>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
              <tr>
                <th scope="row" class="product-comparison__label-col">Processor</th>
                {%- assign current_processor = product.metafields.comparison.processor.value -%}
                {%- if current_processor == blank -%}{%- assign current_processor = product.metafields.custom.comparison_processor.value -%}{%- endif -%}
                {%- if current_processor == blank -%}{%- assign current_processor = product.metafields.custom['comparison.processor'].value -%}{%- endif -%}
                {%- if current_processor == blank -%}{%- assign current_processor = product.metafields.comparison.processor | metafield_text -%}{%- endif -%}
                <td class="product-comparison__product-col product-comparison__product-col--current">
                  {%- if current_processor != blank -%}
                    {%- assign current_processor_short = current_processor | strip_html | truncatewords: 12, '...' -%}
                    <span class="product-comparison__spec-compact" title="{{ current_processor | strip_html | escape }}">{{ current_processor_short }}</span>
                  {%- else -%}
                    N/A
                  {%- endif -%}
                </td>
                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    {%- assign candidate_processor = candidate.metafields.comparison.processor.value -%}
                    {%- if candidate_processor == blank -%}{%- assign candidate_processor = candidate.metafields.custom.comparison_processor.value -%}{%- endif -%}
                    {%- if candidate_processor == blank -%}{%- assign candidate_processor = candidate.metafields.custom['comparison.processor'].value -%}{%- endif -%}
                    {%- if candidate_processor == blank -%}{%- assign candidate_processor = candidate.metafields.comparison.processor | metafield_text -%}{%- endif -%}
                    <td class="product-comparison__product-col">
                      {%- if candidate_processor != blank -%}
                        {%- assign candidate_processor_short = candidate_processor | strip_html | truncatewords: 12, '...' -%}
                        <span class="product-comparison__spec-compact" title="{{ candidate_processor | strip_html | escape }}">{{ candidate_processor_short }}</span>
                      {%- else -%}
                        N/A
                      {%- endif -%}
                    </td>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
              <tr>
                <th scope="row" class="product-comparison__label-col">Graphics</th>
                {%- assign current_graphics = product.metafields.comparison['graphics.card'].value -%}
                {%- if current_graphics == blank -%}{%- assign current_graphics = product.metafields['comparison.graphics'].card.value -%}{%- endif -%}
                {%- if current_graphics == blank -%}{%- assign current_graphics = product.metafields.custom.comparison_graphics_card.value -%}{%- endif -%}
                {%- if current_graphics == blank -%}{%- assign current_graphics = product.metafields.custom['comparison.graphics.card'].value -%}{%- endif -%}
                {%- if current_graphics == blank -%}{%- assign current_graphics = product.metafields.comparison['graphics.card'] | metafield_text -%}{%- endif -%}
                <td class="product-comparison__product-col product-comparison__product-col--current">
                  {%- if current_graphics != blank -%}
                    {%- assign current_graphics_short = current_graphics | strip_html | truncatewords: 10, '...' -%}
                    <span class="product-comparison__spec-compact" title="{{ current_graphics | strip_html | escape }}">{{ current_graphics_short }}</span>
                  {%- else -%}
                    N/A
                  {%- endif -%}
                </td>
                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    {%- assign candidate_graphics = candidate.metafields.comparison['graphics.card'].value -%}
                    {%- if candidate_graphics == blank -%}{%- assign candidate_graphics = candidate.metafields['comparison.graphics'].card.value -%}{%- endif -%}
                    {%- if candidate_graphics == blank -%}{%- assign candidate_graphics = candidate.metafields.custom.comparison_graphics_card.value -%}{%- endif -%}
                    {%- if candidate_graphics == blank -%}{%- assign candidate_graphics = candidate.metafields.custom['comparison.graphics.card'].value -%}{%- endif -%}
                    {%- if candidate_graphics == blank -%}{%- assign candidate_graphics = candidate.metafields.comparison['graphics.card'] | metafield_text -%}{%- endif -%}
                    <td class="product-comparison__product-col">
                      {%- if candidate_graphics != blank -%}
                        {%- assign candidate_graphics_short = candidate_graphics | strip_html | truncatewords: 10, '...' -%}
                        <span class="product-comparison__spec-compact" title="{{ candidate_graphics | strip_html | escape }}">{{ candidate_graphics_short }}</span>
                      {%- else -%}
                        N/A
                      {%- endif -%}
                    </td>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
              <tr>
                <th scope="row" class="product-comparison__label-col">Availability</th>
                <td class="product-comparison__product-col product-comparison__product-col--current">
                  {% if product.available %}In stock{% else %}Out of stock{% endif %}
                </td>
                {%- assign shown_products = 0 -%}
                {%- for candidate in comparison_products -%}
                  {%- if candidate.id != product.id and shown_products < max_similar_products -%}
                    <td class="product-comparison__product-col">
                      {% if candidate.available %}In stock{% else %}Out of stock{% endif %}
                    </td>
                    {%- assign shown_products = shown_products | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            </tbody>
          </table>
        </div>
      {%- else -%}
        <p class="product-comparison__empty">No similar products found to compare.</p>
      {%- endif -%}
    {%- else -%}
      <p class="product-comparison__empty">Assign this product to a collection or choose a comparison collection in this section.</p>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Product comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Compare Similar Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how this product stacks up against similar options"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h2"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Comparison collection",
      "info": "Optional. If empty, the first collection of the current product is used."
    },
    {
      "type": "range",
      "id": "products_to_compare",
      "label": "Similar products to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "debug_metafields",
      "label": "Show metafield source labels",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product comparison"
    }
  ]
}
{% endschema %}

