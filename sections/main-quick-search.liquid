{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'collection-quick-see-through.css' | asset_url | stylesheet_tag }}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.enable_quick_see_through -%}
  <script src="{{ 'collection-quick-see-through.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .quick-search-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .quick-search-title {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% comment %} Get all products using search with empty query {% endcomment %}
{%- if section.settings.collection != blank -%}
  {%- assign quick_search_collection = collections[section.settings.collection] -%}
{%- else -%}
  {%- assign quick_search_collection = search.results -%}
{%- endif -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width quick-search-header">
    <h1 class="h2 quick-search-title">{{ section.settings.heading | escape }}</h1>
  </div>

  {%- if quick_search_collection == blank -%}
    <div class="page-width">
      <p>{{ 'sections.collection_template.empty' | t }}</p>
    </div>
  {%- else -%}
    {%- paginate quick_search_collection.products by section.settings.products_per_page -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = quick_search_collection.sort_by | default: quick_search_collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in quick_search_collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {{ 'products.facets.product_count_simple' | t: count: quick_search_collection.products_count }}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>

      <div class="facets-vertical page-width">
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: quick_search_collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: 'vertical',
            paginate: paginate
          %}
        </aside>

        <div class="product-grid-container" id="ProductGridContainer">
          {%- if quick_search_collection.products.size == 0 -%}
            <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div class="collection">
              <div class="loading-overlay gradient"></div>
              <ul
                id="product-grid"
                data-id="{{ section.id }}"
                class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
              >
                {% assign skip_card_product_styles = false %}
                {%- for product in quick_search_collection.products -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  <li class="grid__item">
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      lazy_load: lazy_load,
                      skip_styles: skip_card_product_styles,
                      quick_add: 'none',
                      quick_see_through: section.settings.enable_quick_see_through,
                      section_id: section.id
                    %}
                  </li>
                  {%- assign skip_card_product_styles = true -%}
                {%- endfor -%}
              </ul>

              <div class="page-width">
                <div class="product-count light" role="status">
                  <p class="product-count__text text-body">
                    <span id="ProductCount">
                      {{ 'products.facets.product_count_simple' | t: count: quick_search_collection.products_count }}
                    </span>
                  </p>
                  {%- render 'loading-spinner' -%}
                </div>
              </div>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}

    {% if section.settings.enable_quick_see_through %}
      <dialog class="collection-quick-see-through-modal" id="QuickSeeThrough-{{ section.id }}" aria-labelledby="QuickSeeThroughTitle-{{ section.id }}">
        <button type="button" class="collection-quick-see-through-modal__close" data-quick-see-close aria-label="{{ 'accessibility.close' | t }}">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
        <div class="collection-quick-see-through-modal__body" data-quick-see-body>
          <div class="collection-quick-see-through-modal__media-wrap">
            <img data-quick-see-image src="" alt="" loading="lazy">
          </div>
          <div class="collection-quick-see-through-modal__content">
            <p class="collection-quick-see-through-modal__vendor" data-quick-see-vendor hidden></p>
            <h3 class="collection-quick-see-through-modal__title" id="QuickSeeThroughTitle-{{ section.id }}" data-quick-see-title></h3>
            <p class="collection-quick-see-through-modal__price" data-quick-see-price></p>
            <div class="collection-quick-see-through-modal__actions">
              <form method="post" action="/cart/add" data-quick-see-cart-form>
                <input type="hidden" name="id" value="" data-quick-see-variant-id>
                <button type="submit" class="button button--primary" data-quick-see-submit>
                  {{ 'products.product.add_to_cart' | t }}
                </button>
              </form>
              <a href="#" class="button button--secondary" data-quick-see-details>
                {{ 'products.product.view_full_details' | t }}
              </a>
            </div>
          </div>
        </div>
      </dialog>
    {% endif %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main quick search",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Quick search",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "blob",
          "label": "Blob"
        },
        {
          "value": "chevronleft",
          "label": "Chevron left"
        },
        {
          "value": "chevronright",
          "label": "Chevron right"
        },
        {
          "value": "diamond",
          "label": "Diamond"
        },
        {
          "value": "parallelogram",
          "label": "Parallelogram"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "default",
      "label": "Image shape"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show secondary image"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show rating"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_see_through",
      "default": true,
      "label": "Enable quick see-through"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Main quick search"
    }
  ]
}
{% endschema %}
