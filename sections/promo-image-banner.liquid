{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .promo-image-banner {
    display: block;
    width: 100%;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  @media screen and (min-width: 750px) {
    .promo-image-banner {
      display: none;
    }
  }

  .promo-image-banner__link {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  .promo-image-banner__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 0;
    background: #111827;
    aspect-ratio: {{ section.settings.mobile_aspect_ratio }};
  }

  @media screen and (min-width: 750px) {
    .promo-image-banner__frame {
      aspect-ratio: {{ section.settings.desktop_aspect_ratio }};
    }
  }

  .promo-image-banner__image,
  .promo-image-banner__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .promo-image-banner__placeholder {
    background: linear-gradient(135deg, #e5e7eb, #cbd5e1);
  }

  .promo-image-banner__placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
  }
{%- endstyle -%}

<section class="promo-image-banner section-{{ section.id }}-padding">
  {%- if section.settings.link != blank -%}
    <a class="promo-image-banner__link" href="{{ section.settings.link }}">
  {%- endif -%}
  <div class="promo-image-banner__frame">
    {%- if section.settings.image != blank or section.settings.mobile_image != blank -%}
      {%- if section.settings.mobile_image != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w,
              {{ section.settings.mobile_image | image_url: width: 1500 }} 1500w
            "
          >
        </picture>
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            class: 'promo-image-banner__image',
            widths: '750, 1100, 1500, 2400',
            sizes: '100vw'
        }}
      {%- else -%}
        {{
          section.settings.mobile_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            class: 'promo-image-banner__image',
            widths: '750, 1100, 1500, 2400',
            sizes: '100vw'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'promo-image-banner__placeholder placeholder-svg' }}
    {%- endif -%}
  </div>
  {%- if section.settings.link != blank -%}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Promo image banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "desktop_aspect_ratio",
      "label": "Desktop aspect ratio",
      "default": "1920 / 520",
      "options": [
        { "value": "1920 / 520", "label": "Wide" },
        { "value": "1600 / 480", "label": "Balanced" },
        { "value": "1440 / 420", "label": "Taller" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile aspect ratio",
      "default": "960 / 560",
      "options": [
        { "value": "960 / 560", "label": "Balanced" },
        { "value": "960 / 640", "label": "Tall" },
        { "value": "960 / 480", "label": "Short" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Bottom padding"
    }
  ],
  "presets": [
    {
      "name": "Promo image banner"
    }
  ]
}
{% endschema %}
