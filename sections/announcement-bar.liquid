{%- comment -%}
  RentOPC Header & Navigation v2 — Announcement Bar (Phase 1)
  Source of truth: Build Spec 01 (v2, Final for Build) §3 Band 1, §4 Announcement, §7 Copy, §12 Things to avoid.

  All copy is HARD-CODED from spec §7. No merchant-editable settings for copy — the
  spec is the source of truth, not the CMS. If warranty terms change, edit this file.

  Behaviour: static, no slider, no rotation, no close, no animation, no countdown.
  Height:    32px desktop / 30px mobile. Scrolls away with the page (not sticky).
{%- endcomment -%}

<div
  class="rop-announcement-bar"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
>
  <div class="rop-announcement-bar__inner">
    <p class="rop-announcement-bar__facts">
      <span class="rop-announcement-bar__facts--desktop">6-month warranty · Free shipping across India · COD available · GST invoice</span>
      <span class="rop-announcement-bar__facts--medium">6-month warranty · Free shipping across India · COD available</span>
      <span class="rop-announcement-bar__facts--mobile">6-month warranty · Free shipping · COD</span>
    </p>

    <a
      class="rop-announcement-bar__phone"
      href="tel:+917011898220"
      rel="nofollow"
    >Call 70118 98220</a>
  </div>
</div>

<style>
  /* Announcement bar — spec §3 Band 1 (desktop) & §4 (mobile).
     Uses --rop-* tokens declared in assets/base.css. All heights are
     declared before first paint so zero CLS is contributed by this bar. */

  .rop-announcement-bar {
    background-color: var(--rop-color-ink-900);
    color: var(--rop-color-paper);
    width: 100%;
    position: relative; /* NOT sticky — spec §3 Band 1 "scrolls away and does not return" */
    z-index: 3;
    height: var(--rop-header-announcement-h, 32px);
    line-height: 1;
  }

  .rop-announcement-bar__inner {
    max-width: 1280px;
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--rop-space-6, 32px);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    gap: var(--rop-space-4, 16px);
  }

  .rop-announcement-bar__facts {
    margin: 0;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--rop-color-paper);
    text-align: center;
    white-space: nowrap;
  }
  .rop-announcement-bar__facts--desktop { display: inline; }
  .rop-announcement-bar__facts--medium  { display: none; }
  .rop-announcement-bar__facts--mobile  { display: none; }

  .rop-announcement-bar__phone {
    position: absolute;
    right: var(--rop-space-6, 32px);
    top: 50%;
    transform: translateY(-50%);
    font-size: 13px;
    font-weight: 400;
    line-height: 1;
    color: var(--rop-color-paper);
    opacity: 0.80;
    text-decoration: none;
    letter-spacing: 0;
  }
  .rop-announcement-bar__phone:hover,
  .rop-announcement-bar__phone:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rop-announcement-bar__phone:focus-visible {
    outline: 2px solid var(--rop-color-focus, #2563EB);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Responsive copy swaps per spec §7:
     • < 1180px  → drop "GST invoice"      (uses --medium)
     • < 990px   → mobile string + hide phone link (uses --mobile) */
  @media (max-width: 1179.98px) and (min-width: 990px) {
    .rop-announcement-bar__facts--desktop { display: none; }
    .rop-announcement-bar__facts--medium  { display: inline; }
  }
  @media (max-width: 989.98px) {
    .rop-announcement-bar {
      height: 30px; /* spec §4 Announcement */
    }
    .rop-announcement-bar__inner {
      padding: 0 var(--rop-space-4, 16px);
    }
    .rop-announcement-bar__facts {
      font-size: 12px;
    }
    .rop-announcement-bar__facts--desktop { display: none; }
    .rop-announcement-bar__facts--medium  { display: none; }
    .rop-announcement-bar__facts--mobile  { display: inline; }
    .rop-announcement-bar__phone          { display: none; }
  }
</style>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": []
}
{% endschema %}
