{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    {%- liquid
      assign has_processor_option = false
      for opt in product.options_with_values
        assign opt_name = opt.name | downcase
        assign opt_is_processor = false

        if opt_name contains 'processor' or opt_name contains 'cpu' or opt_name contains 'chip'
          assign opt_is_processor = true
        endif

        if opt_is_processor == false
          for v in opt.values
            assign v_up = v | upcase
            if v_up contains 'I3' or v_up contains 'I5' or v_up contains 'I7' or v_up contains 'I9' or v_up contains 'RYZEN' or v_up contains 'CELERON' or v_up contains 'PENTIUM' or v_up contains 'XEON' or v_up contains 'M1' or v_up contains 'M2' or v_up contains 'M3'
              assign opt_is_processor = true
              break
            endif
          endfor
        endif

        if opt_is_processor
          assign has_processor_option = true
          break
        endif
      endfor

      assign option_index = 0
    -%}

    {%- if has_processor_option -%}
      {%- for option in product.options_with_values -%}
        {%- liquid
          assign opt_name = option.name | downcase
          assign is_processor = false
          if opt_name contains 'processor' or opt_name contains 'cpu' or opt_name contains 'chip'
            assign is_processor = true
          endif
          if is_processor == false
            for v in option.values
              assign v_up = v | upcase
              if v_up contains 'I3' or v_up contains 'I5' or v_up contains 'I7' or v_up contains 'I9' or v_up contains 'RYZEN' or v_up contains 'CELERON' or v_up contains 'PENTIUM' or v_up contains 'XEON' or v_up contains 'M1' or v_up contains 'M2' or v_up contains 'M3'
                assign is_processor = true
                break
              endif
            endfor
          endif
        -%}
        {%- if is_processor -%}
          {% render 'product-variant-picker-option',
            product: product,
            option: option,
            block: block,
            product_form_id: product_form_id,
            section_id: section.id,
            option_index: option_index
          %}
          {%- assign option_index = option_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for option in product.options_with_values -%}
        {%- liquid
          assign opt_name = option.name | downcase
          assign is_processor = false
          assign is_ram = false
          if opt_name contains 'ram' or opt_name contains 'memory'
            assign is_ram = true
          endif
          if opt_name contains 'processor' or opt_name contains 'cpu' or opt_name contains 'chip'
            assign is_processor = true
          endif
          if is_processor == false
            for v in option.values
              assign v_up = v | upcase
              if v_up contains 'I3' or v_up contains 'I5' or v_up contains 'I7' or v_up contains 'I9' or v_up contains 'RYZEN' or v_up contains 'CELERON' or v_up contains 'PENTIUM' or v_up contains 'XEON' or v_up contains 'M1' or v_up contains 'M2' or v_up contains 'M3'
                assign is_processor = true
                break
              endif
            endfor
          endif
        -%}
        {%- if is_ram and is_processor == false -%}
          {% render 'product-variant-picker-option',
            product: product,
            option: option,
            block: block,
            product_form_id: product_form_id,
            section_id: section.id,
            option_index: option_index
          %}
          {%- assign option_index = option_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for option in product.options_with_values -%}
        {%- liquid
          assign opt_name = option.name | downcase
          assign is_processor = false
          assign is_ram = false
          assign is_storage = false
          if opt_name contains 'ram' or opt_name contains 'memory'
            assign is_ram = true
          endif
          if opt_name contains 'ssd' or opt_name contains 'hdd' or opt_name contains 'storage'
            assign is_storage = true
          endif
          if opt_name contains 'processor' or opt_name contains 'cpu' or opt_name contains 'chip'
            assign is_processor = true
          endif
          if is_processor == false
            for v in option.values
              assign v_up = v | upcase
              if v_up contains 'I3' or v_up contains 'I5' or v_up contains 'I7' or v_up contains 'I9' or v_up contains 'RYZEN' or v_up contains 'CELERON' or v_up contains 'PENTIUM' or v_up contains 'XEON' or v_up contains 'M1' or v_up contains 'M2' or v_up contains 'M3'
                assign is_processor = true
                break
              endif
            endfor
          endif
        -%}
        {%- if is_storage and is_processor == false and is_ram == false -%}
          {% render 'product-variant-picker-option',
            product: product,
            option: option,
            block: block,
            product_form_id: product_form_id,
            section_id: section.id,
            option_index: option_index
          %}
          {%- assign option_index = option_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for option in product.options_with_values -%}
        {%- liquid
          assign opt_name = option.name | downcase
          assign is_processor = false
          assign is_ram = false
          assign is_storage = false
          if opt_name contains 'ram' or opt_name contains 'memory'
            assign is_ram = true
          endif
          if opt_name contains 'ssd' or opt_name contains 'hdd' or opt_name contains 'storage'
            assign is_storage = true
          endif
          if opt_name contains 'processor' or opt_name contains 'cpu' or opt_name contains 'chip'
            assign is_processor = true
          endif
          if is_processor == false
            for v in option.values
              assign v_up = v | upcase
              if v_up contains 'I3' or v_up contains 'I5' or v_up contains 'I7' or v_up contains 'I9' or v_up contains 'RYZEN' or v_up contains 'CELERON' or v_up contains 'PENTIUM' or v_up contains 'XEON' or v_up contains 'M1' or v_up contains 'M2' or v_up contains 'M3'
                assign is_processor = true
                break
              endif
            endfor
          endif
        -%}
        {%- if is_processor == false and is_ram == false and is_storage == false -%}
          {% render 'product-variant-picker-option',
            product: product,
            option: option,
            block: block,
            product_form_id: product_form_id,
            section_id: section.id,
            option_index: option_index
          %}
          {%- assign option_index = option_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for option in product.options_with_values -%}
        {% render 'product-variant-picker-option',
          product: product,
          option: option,
          block: block,
          product_form_id: product_form_id,
          section_id: section.id,
          option_index: forloop.index0
        %}
      {%- endfor -%}
    {%- endif -%}

		    <script type="application/json" data-selected-variant>
		      {{ product.selected_or_first_available_variant | json }}
		    </script>
      <script type="application/json" data-product-variants>
        {{ product.variants | json }}
      </script>
	  </variant-selects>
{%- endunless -%}
