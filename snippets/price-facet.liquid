{%- comment -%}
  Slider UI for the `price_range` filter.
  Renders two `type="range"` inputs (min/max) instead of number inputs.
{%- endcomment -%}

{%- assign range_max = filter.range_max | money_without_currency | replace: ',', '' | replace: '.00', '' -%}
{%- assign current_min = filter.min_value.value | money_without_currency | replace: ',', '' | replace: '.00', '' | default: '0' -%}
{%- assign current_max = filter.max_value.value | money_without_currency | replace: ',', '' | replace: '.00', '' | default: range_max -%}

<div class="price-slider-wrapper" data-price-slider="{{ id_prefix | escape }}">
  <div class="price-slider-display">
    <span>
      {{ cart.currency.symbol }}<span data-price-slider-min>{{ current_min }}</span>
    </span>
    <span>
      {{ cart.currency.symbol }}<span data-price-slider-max>{{ current_max }}</span>
    </span>
  </div>

  <div class="price-slider-track-wrap">
    <div class="price-slider-track"></div>
    <div class="price-slider-range" data-price-slider-range></div>

    <input
      type="range"
      class="price-range-thumb"
      data-price-slider-input="min"
      name="{{ filter.min_value.param_name }}"
      min="0"
      max="{{ range_max }}"
      data-min="0"
      data-max="{{ range_max }}"
      value="{{ current_min }}"
      step="1"
      style="position:absolute; inset:0; width:100%; appearance:none; -webkit-appearance:none; background:transparent;"
    >
    <input
      type="range"
      class="price-range-thumb"
      data-price-slider-input="max"
      name="{{ filter.max_value.param_name }}"
      min="0"
      max="{{ range_max }}"
      data-min="0"
      data-max="{{ range_max }}"
      value="{{ current_max }}"
      step="1"
      style="position:absolute; inset:0; width:100%; appearance:none; -webkit-appearance:none; background:transparent;"
    >
  </div>

  <script>
  (function() {
    var wrapper = document.currentScript && document.currentScript.closest('.price-slider-wrapper');
    if (!wrapper) return;

    var elMinRange = wrapper.querySelector('[data-price-slider-input="min"]');
    var elMaxRange = wrapper.querySelector('[data-price-slider-input="max"]');
    var elRange = wrapper.querySelector('[data-price-slider-range]');
    var elDisplayMin = wrapper.querySelector('[data-price-slider-min]');
    var elDisplayMax = wrapper.querySelector('[data-price-slider-max]');

    if (!elMinRange || !elMaxRange || !elRange || !elDisplayMin || !elDisplayMax) return;

    var rangeMax = Number(elMaxRange.getAttribute('max')) || 0;
    var minGap = 1;

    function formatNum(n) {
      return Math.round(n).toLocaleString();
    }

    function updateSlider() {
      var minVal = Number(elMinRange.value);
      var maxVal = Number(elMaxRange.value);

      if (rangeMax <= 0) return;

      if (minVal >= maxVal - minGap) {
        if (this === elMinRange) {
          minVal = maxVal - minGap;
          elMinRange.value = minVal;
        } else {
          maxVal = minVal + minGap;
          elMaxRange.value = maxVal;
        }
      }

      var minPct = (minVal / rangeMax) * 100;
      var maxPct = (maxVal / rangeMax) * 100;
      elRange.style.left = minPct + '%';
      elRange.style.width = (maxPct - minPct) + '%';

      elDisplayMin.textContent = formatNum(minVal);
      elDisplayMax.textContent = formatNum(maxVal);
    }

    elMaxRange.style.zIndex = 3;
    elMinRange.style.zIndex = 4;

    elMinRange.addEventListener('input', updateSlider);
    elMaxRange.addEventListener('input', updateSlider);

    updateSlider.call(null);
  })();
  </script>
</div>

<style>
  .price-slider-wrapper {
    width: 100%;
  }

  .price-slider-display {
    display: flex;
    justify-content: space-between;
    font-size: 1.35rem;
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: currentColor;
  }

  .price-slider-track-wrap {
    position: relative;
    height: 26px;
    margin: 0.5rem 0 1.25rem;
    background: rgba(0, 0, 0, 0.06);
    border-radius: 999px;
  }

  .price-slider-track,
  .price-slider-range {
    position: absolute;
    top: 50%;
    height: 4px;
    border-radius: 999px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .price-slider-track {
    left: 0;
    right: 0;
    z-index: 30;
    background: rgba(0, 0, 0, 0.22);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .price-slider-range {
    z-index: 31;
    background: rgba(0, 0, 0, 0.85);
  }

  input[type=range].price-range-thumb {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    cursor: pointer;
    display: block;
    outline: none;
    height: 26px;
    margin: 0;
    padding: 0;
    z-index: 10;
  }
  input[type=range].price-range-thumb::-webkit-slider-thumb {
    -webkit-appearance: none !important;
    appearance: none !important;
    width: 20px !important;
    height: 20px !important;
    margin-top: -8px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
    border: 2px solid #000000 !important;
    cursor: pointer !important;
    box-shadow: 0 1px 4px rgba(0,0,0,0.25) !important;
    font-family: inherit !important;
    content: '' !important;
  }
  input[type=range].price-range-thumb::-moz-range-thumb {
    width: 20px !important;
    height: 20px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
    border: 2px solid #000000 !important;
    cursor: pointer !important;
    pointer-events: all !important;
    box-shadow: 0 1px 4px rgba(0,0,0,0.25) !important;
    font-family: inherit !important;
  }
  input[type=range].price-range-thumb::-webkit-slider-runnable-track {
    background: transparent !important;
    border: 0 !important;
    height: 26px !important;
  }
  input[type=range].price-range-thumb::-moz-range-track {
    background: transparent !important;
    border: 0 !important;
    height: 26px !important;
  }

  input[type=range].price-range-thumb::-moz-range-progress {
    background: transparent !important;
  }

  input[type=range].price-range-thumb::-ms-track {
    background: transparent !important;
    border-color: transparent !important;
    color: transparent !important;
    height: 26px !important;
  }

  input[type=range].price-range-thumb::-ms-thumb {
    margin-top: -8px !important;
  }
</style>
