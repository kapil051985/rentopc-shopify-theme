<style>

.onhow-product-title-container {
  width: 100%;
  text-align: center;
  margin-top: 2rem;
  margin-bottom: 5rem;
  position: relative;
  z-index: 1; 
}

.onhow-title-wrapper {
  display: inline-block;
  position: relative;
  padding: 1rem 2rem;
}

.onhow-product-title {
  font-family: var(--font-heading-family);
  font-weight: var(--font-heading-weight);
  font-size: clamp(2.875rem, 7.25vw, 4.75rem); /* Desktop/default size */
  line-height: 0.2;
  margin: 0;
  color: rgb(var(--color-foreground));
}

{% comment %}
<!-- Designed by OnHOW YouTube Channel - Anas El Medlaoui -->
{% endcomment %}


@keyframes onhowTitleFadeIn {
  0% {
    opacity: 0;
    transform: translateY(-20px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.onhow-title-wrapper {
  animation: onhowTitleFadeIn 0.5s cubic-bezier(0.215, 0.61, 0.355, 1) forwards;
}

@media screen and (max-width: 990px) {
  .onhow-product-title-container {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .onhow-title-wrapper {
    padding: 0.75rem 1.5rem;
  }
  
  .onhow-product-title {
    font-size: clamp(1.7rem, 5.5vw, 3rem); 
  }
}

@media screen and (max-width: 750px) {
  .onhow-product-title-container {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  
  .onhow-title-wrapper {
    padding: 0.5rem 1rem;
    width: 90%;
  }
  
  .onhow-product-title {
    font-size: clamp(1.5rem, 5vw, 2.5rem); 
  }
}

@media screen and (max-width: 480px) {  
  .onhow-product-title {
    font-size: clamp(1.25rem, 4.5vw, 2rem); 
  }
}

.product__info-container .product__title {
  display: none !important;
}

header, .header, .header__menu-item, .header__submenu {
  z-index: 10 !important; 
}
</style>

{% comment %}
<!-- Designed by OnHOW YouTube Channel - Anas El Medlaoui -->
{% endcomment %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  
  const productInfoContainer = document.querySelector('.product__info-container');
  let productTitle = '';
  
  if (productInfoContainer) {
    const titleElement = productInfoContainer.querySelector('.product__title h1, .product__title h2');
    
    if (titleElement) {
      productTitle = titleElement.textContent.trim();
    }
  }
  
  const titleHTML = `
    <div class="onhow-product-title-container">
      <div class="onhow-title-wrapper">
        <h1 class="onhow-product-title">${productTitle}</h1>
      </div>
    </div>
  `;
  
  const productGrid = document.querySelector('.product.grid');
  
  if (productGrid && productGrid.parentNode) {
    productGrid.insertAdjacentHTML('beforebegin', titleHTML);
  }
});
</script>