{% comment %}
  Shared page-config scripts — rendered by all GemPages layout variants.
  Usage: {% render 'gempages-page-config' %}
  Contains: window.routes, window.cartStrings, window.variantStrings,
            window.quickOrderListStrings, window.accessibilityStrings,
            and the conditional script/style tags for predictive search,
            cart drawer JS, and mobile quantity fix.
{% endcomment %}

{%- render 'global-window-config' -%}

{%- if settings.predictive_search_enabled -%}
  <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<style>
  @media (max-width: 550px) {
    quantity-input.quantity {
      width: 115px !important;
      min-height: 35px !important;
    }
  }
</style>
