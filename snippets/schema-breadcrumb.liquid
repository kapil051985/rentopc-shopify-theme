{%- comment -%}
  Emits BreadcrumbList JSON-LD structured data.
  Self-gated by request.page_type — safe to render globally from layout.
  Supported page types: product, collection, article, blog, page.
  Home page is intentionally skipped (no breadcrumb needed).
{%- endcomment -%}

{%- liquid
  assign _page_type = request.page_type
  assign _home_name = shop.name
  assign _home_url = request.origin

  assign _emit = false
  if _page_type == 'product' and product != blank
    assign _emit = true
    assign _product_collection = collection
    if _product_collection == blank or _product_collection.id == blank
      assign _product_collection = product.collections.first
    endif
  elsif _page_type == 'collection' and collection != blank
    assign _emit = true
  elsif _page_type == 'article' and article != blank and blog != blank
    assign _emit = true
  elsif _page_type == 'blog' and blog != blank
    assign _emit = true
  elsif _page_type == 'page' and page != blank
    assign _emit = true
  endif
-%}

{%- if _emit -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ _home_name | json }},
      "item": {{ _home_url | json }}
    }
    {%- case _page_type -%}
    {%- when 'product' -%}
      {%- if _product_collection != blank and _product_collection.id != blank -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ _product_collection.title | json }},
        "item": {{ _home_url | append: _product_collection.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ _home_url | append: product.url | json }}
      }
      {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ _home_url | append: product.url | json }}
      }
      {%- endif -%}
    {%- when 'collection' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ _home_url | append: collection.url | json }}
      }
    {%- when 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ _home_url | append: blog.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ _home_url | append: article.url | json }}
      }
    {%- when 'blog' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ _home_url | append: blog.url | json }}
      }
    {%- when 'page' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": {{ _home_url | append: page.url | json }}
      }
    {%- endcase -%}
  ]
}
</script>
{%- endif -%}
