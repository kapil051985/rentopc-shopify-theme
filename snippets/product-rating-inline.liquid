{%- comment -%}
  Inline product rating component (one line: label + stars + count).
  Uses Shopify Product Reviews metafields: product.metafields.reviews.rating, rating_count.
{%- endcomment -%}

{%- if product and product.metafields.reviews.rating.value != blank -%}
  {%- liquid
    assign rating_decimal = 0
    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif

    assign rating_value_rounded = product.metafields.reviews.rating.value.rating | round: 1
  -%}

  <div
    class="product-rating-inline"
    style="display:inline-flex;align-items:center;gap:10px;flex-wrap:nowrap;white-space:nowrap;"
  >
    <span class="product-rating-inline__label">Rating ({{ rating_value_rounded }})</span>

    <span
      class="rating"
      role="img"
      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
      style="display:inline-flex;align-items:center;"
    >
      <span
        aria-hidden="true"
        class="rating-star"
        style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
      ></span>
    </span>

    {%- if product.metafields.reviews.rating_count != blank -%}
      <span class="product-rating-inline__count" aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
      <span class="visually-hidden">
        {{- product.metafields.reviews.rating_count }}
        {{ 'accessibility.total_reviews' | t -}}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
