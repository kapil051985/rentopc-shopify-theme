<style>
    .collection-slider-wrapper--gm {
        width: 100%;
        max-width: 1600px;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 1.5rem;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-behavior: smooth;
        box-sizing: border-box;
        padding-block: 20px;
        padding-inline: 20px;
        margin: {{ margin_block }}px auto;
      --content-width: {{ collection_width }}px;
    }

  /*To center the main container keeping the horizontal scroll */
      .collection-slider-wrapper--gm::before,
      .collection-slider-wrapper--gm::after {
        content: "";
        margin: auto;
      }

    .collection-slider-content--gm {
        width: var(--content-width);
        height: auto;
        min-height: var(--content-width);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        flex-shrink: 0;
      }

      .collection-slider-content--gm a {
        width: 100%;
        height: 100%;
        text-decoration: none;  
        font-size: 1.5rem;
        text-align: center;
        color: #1e1e1e;
      }

      .collection-image-wrapper {
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        border-radius: 50%;   
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f5f5;
        border: 2px solid #e0e0e0;
      }
     
    .collection-image-wrapper img {
        width: 100%;
        height: 100%;
        aspect-ratio: 1/1;
        object-fit: cover;
        border-radius: 50%;
    }

    .collection-image-wrapper .logo-svg {
        width: 70%;
        height: 70%;
        aspect-ratio: 1/1;
        border-radius: 50%;
        display: block;
    }

    .collection-image-wrapper .screenshot-img {
        width: 100%;
        height: 100%;
        aspect-ratio: 1/1;
        object-fit: cover;
        border-radius: 50%;
    }

    .collection-image-wrapper:hover img  {
        transform: scale(1.1);
        transform-origin: center;
        transition: transform 0.3s ease;
    }

    .collection-image-wrapper:hover .logo-svg,
    .collection-image-wrapper:hover .screenshot-img,
    .collection-image-wrapper:hover .logo-placeholder {
        transform: scale(1.1);
        transform-origin: center;
        transition: transform 0.3s ease;
    }

    @media only screen and (max-width: 992px) {
      .collection-slider-wrapper--gm {
          scrollbar-width: none;
      }
      
     .collection-slider-content--gm {
          width: calc(var(--content-width)/1.5);
          min-height: calc(var(--content-width)/1.5);
      }
    .collection-slider-wrapper--gm::-webkit-scrollbar {
        display: none;
      }
 
    .collection-slider-content--gm a {
      font-size: 1.2rem;
      }
    }

    @media only screen and (max-width: 640px){
    .collection-slider-content--gm {
      width: calc(var(--content-width)/2);
      min-height: calc(var(--content-width)/2);
    }
    .collection-slider-wrapper--gm {
      padding-inline: 12px;
      gap: 1.2rem;
    }
  }


/* ===== Scrollbar CSS ===== */
.collection-slider-wrapper--gm {
    scrollbar-width: auto;
    scrollbar-color: {{ scrollbar_color }} #FFFFE0;
  }

  /* Chrome, Edge, and Safari */
  .collection-slider-wrapper--gm::-webkit-scrollbar {
    width: 16px;
  }

  .collection-slider-wrapper--gm::-webkit-scrollbar-track {
    background: #FFFFE0;
    border-radius: 100px;
  }

  .collection-slider-wrapper--gm::-webkit-scrollbar-thumb {
    background-color: {{ scrollbar_color }};
    border-radius: 100px !important;
    border: 3px solid #ffffff;
  }

/* ===== Scrollbar CSS ===== */


</style>

<div class="collection-slider-content--gm" {{ block.shopify_attributes }}>
    <a href="{{ collection_url }}">
      <div class="collection-image-wrapper">
        {% assign company_lower = collection_name | downcase %}
        {% case company_lower %}
          {% when 'dell' %}
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@v12/icons/dell.svg" alt="Dell Logo" class="logo-svg" loading="lazy">
          {% when 'hp' %}
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@v12/icons/hp.svg" alt="HP Logo" class="logo-svg" loading="lazy">
          {% when 'lenovo' %}
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@v12/icons/lenovo.svg" alt="Lenovo Logo" class="logo-svg" loading="lazy">
          {% when 'toshiba' %}
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@v12/icons/toshiba.svg" alt="Toshiba Logo" class="logo-svg" loading="lazy">
          {% when 'acer' %}
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@v12/icons/acer.svg" alt="Acer Logo" class="logo-svg" loading="lazy">
          {% else %}
            {{ collection_image | image_url: width: 300, height: 300 | image_tag: alt: collection_name, crop: "center", class: "screenshot-img" }}
        {% endcase %}
      </div>
      {{ collection_name }}
    </a>
</div>



