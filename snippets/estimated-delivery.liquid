{% if only_date %}
  <span id="min-delivery-date-only"></span> to <span id="max-delivery-date-only"></span>
{% else %}
<div class="estimated-delivery-container">
  {%- if delivery_icon != blank -%}
    <img
      src="{{ delivery_icon | image_url: width: 48 }}"
      alt="Shipping Icon"
      width="24"
      height="24"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
      style="vertical-align: middle; margin-right: 5px; height: 24px; width: 24px;"
    >
  {%- endif -%}
  <span>{{ delivery_text }}</span>
  <span id="min-delivery-date" style="display: inline-block;"></span> to <span id="max-delivery-date" style="display: inline-block;"></span>
</div>
{% endif %}

<style>
@media only screen and (max-width: 768px) {
    .estimated-delivery-container {
      text-align: center;
      font-size: 12px; 
      color: #333;
    }
}
</style>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    var today = new Date();
    var minDeliveryDate = new Date(today);
    var maxDeliveryDate = new Date(today);
    minDeliveryDate.setDate(today.getDate() + {{ min_delivery | default: 3 }}); // Min delivery date
    maxDeliveryDate.setDate(today.getDate() + {{ max_delivery | default: 7 }}); // Max delivery date

    var minDay = formatDate(minDeliveryDate);
    var maxDay = formatDate(maxDeliveryDate);

    if (document.getElementById("min-delivery-date")) document.getElementById("min-delivery-date").textContent = minDay;
    if (document.getElementById("max-delivery-date")) document.getElementById("max-delivery-date").textContent = maxDay;
    if (document.getElementById("min-delivery-date-only")) document.getElementById("min-delivery-date-only").textContent = minDay;
    if (document.getElementById("max-delivery-date-only")) document.getElementById("max-delivery-date-only").textContent = maxDay;
    if (document.getElementById("card-delivery-date")) document.getElementById("card-delivery-date").textContent = minDay + ' - ' + maxDay;
  });

  function formatDate(date) {
    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var day = date.getDate();
    var monthIndex = date.getMonth();
    return day + ' ' + months[monthIndex];
  }
</script>
