{%- comment -%}
  Emits FAQPage JSON-LD structured data.

  Usage:
    {%- render 'schema-faq', blocks: section.blocks -%}

  Accepts a `blocks` parameter (array of block objects), each block expected
  to expose `settings.question` and `settings.answer`. Blocks with a blank
  question or blank answer are skipped so the resulting JSON is always valid.

  Renders nothing if `blocks` is empty or no valid Q/A pair exists.
{%- endcomment -%}

{%- if blocks and blocks.size > 0 -%}
  {%- assign _has_any = false -%}
  {%- for _block in blocks -%}
    {%- assign _q = _block.settings.question | strip_html | strip -%}
    {%- assign _a = _block.settings.answer | strip_html | strip -%}
    {%- if _q != blank and _a != blank -%}
      {%- assign _has_any = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if _has_any -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign _emitted = 0 -%}
    {%- for _block in blocks -%}
      {%- assign _q = _block.settings.question | strip_html | strip -%}
      {%- assign _a = _block.settings.answer | strip_html | strip -%}
      {%- if _q != blank and _a != blank -%}
        {%- if _emitted > 0 -%},{%- endif -%}
        {
          "@type": "Question",
          "name": {{ _q | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ _a | json }}
          }
        }
        {%- assign _emitted = _emitted | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
  {%- endif -%}
{%- endif -%}
