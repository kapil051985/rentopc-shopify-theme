<style>
  .product-addon-container-gm {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 100%;
    background-color: {{ addon_bg }}; 
    padding: 5px;
    border-radius: 5px;
    box-sizing: border-box;
  }

  .product-addon-container-gm .product-addon-item {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .product-addon-container-gm .product-addon-item .product-addon-checkbox {
    cursor: pointer;
    accent-color: {{ checkbox_active_color }};
  }

  .product-addon-image {
    width: {{ image_size }}px;
    height: {{ image_size }}px;
    object-fit: cover;
    border-radius: {{ image_type }}%;
  }

  .product-addon-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .product-addon-title {
    font-size: {{ title_size }}px;
    font-weight: {{ font_weight }}; 
    color: {{ title_color }}; 
  }

  .product-addon-price {
    font-size: {{ price_size }}px;
    color: {{ price_color }}; 
    opacity: {{ price_opacity }}; 
  }

  @media only screen and (max-width: 600px) {
    .product-addon-image {
      width: {{ image_size_mb }}px;
      height: {{ image_size_mb }}px;
    }
    .product-addon-title {
      font-size: {{ title_size_mb }}px;
    }
    .product-addon-price {
      font-size: {{ price_size_mb }}px;
    }
  }
  
</style>

{%- liquid
  assign addon_img_desktop = image_size | default: 32 | plus: 0
  assign addon_img_mobile = image_size_mb | default: addon_img_desktop | plus: 0
  assign addon_img_render = addon_img_desktop | at_least: addon_img_mobile
  assign addon_img_render_2x = addon_img_render | times: 2
  if addon_img_render < 24
    assign addon_img_render = 24
    assign addon_img_render_2x = addon_img_render | times: 2
  endif
-%}

<div class="product-addon-container-gm">
  {% for product in product_addon %}
    {% if product != blank and product.available %}
      <div class="product-addon-item" data-product-id="{{ product.variants.first.id }}">
        <input
          style="width: {{ checkbox_size }}px !important; height: {{ checkbox_size }}px !important; min-width: {{ checkbox_size }}px !important; min-height: {{ checkbox_size }}px !important;"
          type="checkbox"
          class="product-addon-checkbox"
          id="product-addon-checkbox-{{ forloop.index }}"
          name="product-addon-checkbox-{{ forloop.index }}"
          data-product-id="{{ product.variants.first.id }}"
        >
        {%- if product.featured_image != blank -%}
          <img
            class="product-addon-image"
            src="{{ product.featured_image | image_url: width: addon_img_render }}"
            srcset="{{ product.featured_image | image_url: width: addon_img_render }} 1x, {{ product.featured_image | image_url: width: addon_img_render_2x }} 2x"
            alt="{{ product.title | escape }}"
            width="{{ addon_img_render }}"
            height="{{ addon_img_render }}"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          >
        {%- endif -%}
        <div class="product-addon-details">
          <span class="product-addon-title">{{ product.title | truncatewords: 4 }}</span>
          {% if product.tags contains 'free-gift' %}
            <span class="product-addon-price">{{ free_gift_info }}</span>
          {% else %}
            <span class="product-addon-price">{{ product.price | money }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>



	<script>
	  (function () {
	    var SECTIONS_TO_RENDER = ['cart-icon-bubble'];

	    function updateCartIconBubble(sections) {
	      try {
	        var cartIconBubble = document.getElementById('cart-icon-bubble');
	        var sectionHtml = sections && sections['cart-icon-bubble'];
	        if (!cartIconBubble || !sectionHtml) return;

	        cartIconBubble.innerHTML = new DOMParser()
	          .parseFromString(sectionHtml, 'text/html')
	          .querySelector('.shopify-section').innerHTML;
	      } catch (error) {
	        // No-op: bubble update is non-critical.
	      }
	    }

	    function initProductAddons() {
	      var container = document.querySelector('.product-addon-container-gm');
	      if (!container) return;

	      container.addEventListener('change', function (event) {
	        var checkbox = event && event.target;
	        if (!checkbox || !checkbox.classList || !checkbox.classList.contains('product-addon-checkbox')) return;

	        var productId = checkbox.getAttribute('data-product-id');
	        if (!productId) return;

	        checkbox.disabled = true;

	        var endpoint = checkbox.checked
	          ? ((window.routes && window.routes.cart_add_url) || '/cart/add.js')
	          : ((window.routes && window.routes.cart_change_url) || '/cart/change.js');

	        var request;
	        if (checkbox.checked) {
	          var config = (typeof fetchConfig === 'function') ? fetchConfig('javascript') : { method: 'POST', headers: {} };
	          config.headers = config.headers || {};
	          config.headers['X-Requested-With'] = 'XMLHttpRequest';
	          try { delete config.headers['Content-Type']; } catch (e) {}

	          var formData = new FormData();
	          formData.append('id', productId);
	          formData.append('quantity', 1);
	          formData.append('sections', SECTIONS_TO_RENDER);
	          formData.append('sections_url', window.location.pathname);
	          config.body = formData;

	          request = fetch(endpoint, config)
	            .then(function (response) { return response.json(); })
	            .then(function (response) {
	              updateCartIconBubble(response && response.sections);
	              if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.cartUpdate) {
	                publish(PUB_SUB_EVENTS.cartUpdate, { source: 'product-addon', productVariantId: productId, cartData: response });
	              }
	            });
	        } else {
	          var body = JSON.stringify({
	            id: productId,
	            quantity: 0,
	            sections: SECTIONS_TO_RENDER,
	            sections_url: window.location.pathname,
	          });

	          var configChange = (typeof fetchConfig === 'function')
	            ? fetchConfig()
	            : { method: 'POST', headers: { 'Content-Type': 'application/json' } };
	          configChange.body = body;

	          request = fetch(endpoint, configChange)
	            .then(function (response) { return response.text(); })
	            .then(function (state) {
	              var parsedState = JSON.parse(state || '{}');
	              updateCartIconBubble(parsedState && parsedState.sections);
	              if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.cartUpdate) {
	                publish(PUB_SUB_EVENTS.cartUpdate, { source: 'product-addon', productVariantId: productId, cartData: parsedState });
	              }
	            });
	        }

	        Promise.resolve(request)
	          .catch(function () {
	            // Keep silent: addon should not interrupt main purchase flow.
	          })
	          .finally(function () {
	            checkbox.disabled = false;
	          });
	      });
	    }

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(initProductAddons, { timeout: 2000 });
    } else {
      window.setTimeout(initProductAddons, 0);
    }
  })();
</script>
